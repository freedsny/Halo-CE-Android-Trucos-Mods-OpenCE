+/* the guest's, when the HUD's parts move (port/linux/src/touch_input.c):
+count parts' rectangles, 4 fractions of the screen each */
+void host_touch_hud(const float *rects, int count)
+{
+	if (count > TOUCH_HUD_PARTS)
+		count = TOUCH_HUD_PARTS;
+	if (count <= 0)
+		return;
+	pthread_mutex_lock(&touch_lock);
+	memcpy(touch_hud_rects, rects, (size_t)count * 4 * sizeof(float));
+	touch_hud_serial++;
+	pthread_mutex_unlock(&touch_lock);
+}
