+/* ---------- port: the wide flashlight (TRUCOS, LINTERNA AMPLIA,
+cheats.wide_flashlight)
+
+The first-person flashlight's lights (_light_definition_is_first_person_
+flashlight_bit) made to reach farther and their cone wider, in the map's
+tags while it is loaded, and put back as they were when it is turned off.
+Their runtime cosines and sine, which the tools wrote, are worked out again
+the way the map has them (of the angle, or of half of it) */
+#define LIGHT_PORT_MAXIMUM_FLASHLIGHTS 16
+#define LIGHT_PORT_FLASHLIGHT_RADIUS 1.7f
+#define LIGHT_PORT_FLASHLIGHT_ANGLE 1.5f
+
+static struct
+{
+	long tag_index;
+	real radius;
+	real falloff_angle;
+	real cutoff_angle;
+	real runtime_cosine_falloff_angle;
+	real runtime_cosine_cutoff_angle;
+	real runtime_sine_cutoff_angle;
+} light_port_flashlights[LIGHT_PORT_MAXIMUM_FLASHLIGHTS];
+static short light_port_flashlight_count = 0;
+static boolean light_port_flashlight_wide = FALSE;
+
+/* the cosine (or sine) of a new angle, as the map's value is of the old one:
+of the angle, or of half of it */
+static real light_port_like(
+	real old_angle,
+	real old_value,
+	real new_angle,
+	boolean sine)
+{
+	real whole = sine ? (real)sin(old_angle) : (real)cos(old_angle);
+	real half = sine ? (real)sin(old_angle*0.5f) : (real)cos(old_angle*0.5f);
+
+	if ((real)fabs(half-old_value)<(real)fabs(whole-old_value))
+		return sine ? (real)sin(new_angle*0.5f) : (real)cos(new_angle*0.5f);
+	return sine ? (real)sin(new_angle) : (real)cos(new_angle);
+}
+
+/* a new map: its tags are its own, as the tools made them */
+void light_port_flashlight_forget(
+	void)
+{
+	light_port_flashlight_count = 0;
+	light_port_flashlight_wide = FALSE;
+}
+
+void light_port_flashlight_set(
+	boolean wide)
+{
+	short index;
+
+	if (wide==light_port_flashlight_wide)
+		return;
+	light_port_flashlight_wide = wide;
+	if (wide)
+	{
+		struct tag_iterator iterator;
+		long tag_index;
+
+		light_port_flashlight_count = 0;
+		tag_iterator_new(&iterator, LIGHT_DEFINITION_TAG);
+		for (tag_index = tag_iterator_next(&iterator);
+			tag_index!=NONE && light_port_flashlight_count<LIGHT_PORT_MAXIMUM_FLASHLIGHTS;
+			tag_index = tag_iterator_next(&iterator))
+		{
+			struct point_light_definition *definition = light_definition_get(tag_index);
+			real falloff, cutoff;
+
+			if (!definition || !TEST_FLAG(definition->flags, _light_definition_is_first_person_flashlight_bit))
+				continue;
+			index = light_port_flashlight_count++;
+			light_port_flashlights[index].tag_index = tag_index;
+			light_port_flashlights[index].radius = definition->radius;
+			light_port_flashlights[index].falloff_angle = definition->falloff_angle;
+			light_port_flashlights[index].cutoff_angle = definition->cutoff_angle;
+			light_port_flashlights[index].runtime_cosine_falloff_angle = definition->runtime_cosine_falloff_angle;
+			light_port_flashlights[index].runtime_cosine_cutoff_angle = definition->runtime_cosine_cutoff_angle;
+			light_port_flashlights[index].runtime_sine_cutoff_angle = definition->runtime_sine_cutoff_angle;
+
+			definition->radius *= LIGHT_PORT_FLASHLIGHT_RADIUS;
+			/* (a cone only: an omnidirectional light keeps its angles) */
+			if (definition->cutoff_angle>0.0f && definition->cutoff_angle<_pi/2)
+			{
+				cutoff = MIN(definition->cutoff_angle*LIGHT_PORT_FLASHLIGHT_ANGLE, _pi/2-0.1f);
+				falloff = MIN(definition->falloff_angle*LIGHT_PORT_FLASHLIGHT_ANGLE, cutoff);
+				definition->runtime_cosine_falloff_angle = light_port_like(definition->falloff_angle,
+					definition->runtime_cosine_falloff_angle, falloff, FALSE);
+				definition->runtime_cosine_cutoff_angle = light_port_like(definition->cutoff_angle,
+					definition->runtime_cosine_cutoff_angle, cutoff, FALSE);
+				definition->runtime_sine_cutoff_angle = light_port_like(definition->cutoff_angle,
+					definition->runtime_sine_cutoff_angle, cutoff, TRUE);
+				definition->falloff_angle = falloff;
+				definition->cutoff_angle = cutoff;
+			}
+		}
+	}
+	else
+	{
+		for (index = 0; index<light_port_flashlight_count; index++)
+		{
+			struct point_light_definition *definition = light_definition_get(light_port_flashlights[index].tag_index);
+
+			if (!definition)
+				continue;
+			definition->radius = light_port_flashlights[index].radius;
+			definition->falloff_angle = light_port_flashlights[index].falloff_angle;
+			definition->cutoff_angle = light_port_flashlights[index].cutoff_angle;
+			definition->runtime_cosine_falloff_angle = light_port_flashlights[index].runtime_cosine_falloff_angle;
+			definition->runtime_cosine_cutoff_angle = light_port_flashlights[index].runtime_cosine_cutoff_angle;
+			definition->runtime_sine_cutoff_angle = light_port_flashlights[index].runtime_sine_cutoff_angle;
+		}
+		light_port_flashlight_count = 0;
+	}
+}
