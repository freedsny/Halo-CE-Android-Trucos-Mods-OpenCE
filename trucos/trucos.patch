+/* port: the cheats on the player's own unit while their setting is on
+(TRUCOS): the flashlight's battery kept full, the active camouflage kept on
+(turned off, the player shows again), and the wide flashlight
+(object_lights.c) */
+void light_port_flashlight_set(boolean wide);
+void light_port_flashlight_forget(void);
+void hud_port_guide_teleport_update(void); /* (hud_nav_points.c: TELETRANSPORTE) */
+static boolean cheat_port_infinite_flashlight = FALSE;
+static boolean cheat_port_camouflage = FALSE;
+static boolean cheat_port_overshield = FALSE;
+static boolean cheat_port_camouflage_on = FALSE;
+static boolean cheat_port_wide_flashlight = FALSE;
+static boolean cheat_port_no_fall_damage = FALSE;
+static boolean cheat_port_no_fall_damage_on = FALSE;
+static boolean cheat_port_easy_rider = FALSE;
+static boolean cheat_port_easy_rider_on = FALSE;
+
+static void cheat_port_unit_settings(
+	boolean own_game)
+{
+	long player_index = cheat_player_index();
+	struct unit_datum *unit = NULL;
+
+	if (player_index!=NONE && player_get(player_index)->unit_index!=NONE)
+		unit = unit_get(player_get(player_index)->unit_index);
+	/* the overshield (TRUCOS, SOBRESCUDO INFINITO): charged again to its three
+	times whenever it is below them and the shield is not stunned by a hit (as
+	the powerup does: object_double_charge_shield), so it only goes down while
+	the player is being shot */
+	if (unit && own_game && cheat_port_overshield &&
+		!TEST_FLAG(unit->object.damage_flags, _object_dead_bit) &&
+		unit->object.maximum_shield_vitality>0.f &&
+		!TEST_FLAG(unit->object.damage_flags, _object_shield_over_charging_bit) &&
+		unit->object.shield_stun_ticks==0 && unit->object.shield_vitality<3.f)
+	{
+		SET_FLAG(unit->object.damage_flags, _object_shield_over_charging_bit, TRUE);
+		if (unit->object.shield_vitality==0.f)
+			unit->object.shield_vitality = 0.01f;
+	}
+	if (unit && own_game && cheat_port_infinite_flashlight)
+		unit->unit.integrated_light_battery = 1.0f;
+	if (unit && own_game && cheat_port_camouflage)
+	{
+		/* (on again after a death, which ends it) */
+		if (!TEST_FLAG(unit->unit.flags, _unit_active_camouflaged_bit))
+			cheat_active_camouflage();
+		cheat_port_camouflage_on = TRUE;
+	}
+	else if (cheat_port_camouflage_on)
+	{
+		/* (it fades out as a camouflage running out does) */
+		if (unit)
+			unit->unit.flags &= ~(FLAG(_unit_active_camouflaged_bit) | FLAG(_unit_super_camouflaged_bit));
+		cheat_port_camouflage_on = FALSE;
+	}
+	/* SIN DANO POR CAIDA: the unit's own no-falling-damage flag kept on
+	(bipeds.c), without the jetpack's flying; off, cleared once */
+	if (unit && own_game && cheat_port_no_fall_damage)
+	{
+		SET_FLAG(unit->unit.flags, _unit_no_falling_damage_bit, TRUE);
+		cheat_port_no_fall_damage_on = TRUE;
+	}
+	else if (cheat_port_no_fall_damage_on)
+	{
+		if (unit)
+			SET_FLAG(unit->unit.flags, _unit_no_falling_damage_bit, FALSE);
+		cheat_port_no_fall_damage_on = FALSE;
+	}
+	/* NO CAER DEL VEHICULO: Easy Rider, the riders of a vehicle on its back
+	not thrown out (rider_ejection, bipeds.c) */
+	if (own_game && cheat_port_easy_rider)
+	{
+		rider_ejection = FALSE;
+		cheat_port_easy_rider_on = TRUE;
+	}
+	else if (cheat_port_easy_rider_on)
+	{
+		rider_ejection = TRUE;
+		cheat_port_easy_rider_on = FALSE;
+	}
+	light_port_flashlight_set(cheat_port_wide_flashlight);
+	hud_port_guide_teleport_update();
+}
+
+#define NUMBER_OF_CHEAT_ACTION_SETTINGS (sizeof(cheat_action_settings)/sizeof(cheat_action_settings[0]))
+
+#define NUMBER_OF_CHEAT_SETTINGS (sizeof(cheat_settings)/sizeof(cheat_settings[0]))
+
+/* the settings read again when one changed (config_changes), or when a map
+starts (force) */
+static unsigned long cheat_settings_changes = 0;
+static boolean cheat_settings_read = FALSE;
+
+static void cheats_settings_apply(
+	boolean force)
+{
+	unsigned long changes = config_changes();
+	boolean own_game = game_connection()==_game_connection_local && !network_game_distributed_client();
+	short index;
+
+	/* (a new map's tags are as the tools made them) */
+	if (force)
+		light_port_flashlight_forget();
+	if (force || !cheat_settings_read || changes!=cheat_settings_changes)
+	{
+		cheat_settings_read = TRUE;
+		cheat_settings_changes = changes;
+		cheat_port_infinite_flashlight = config_boolean("cheats.infinite_flashlight")!=0;
+		cheat_port_camouflage = config_boolean("cheats.active_camouflage")!=0;
+		cheat_port_overshield = config_boolean("cheats.overshield")!=0;
+		cheat_port_wide_flashlight = config_boolean("cheats.wide_flashlight")!=0;
+		cheat_port_no_fall_damage = config_boolean("cheats.no_fall_damage")!=0;
+		cheat_port_easy_rider = config_boolean("cheats.easy_rider")!=0;
+		for (index = 0; index<(short)NUMBER_OF_CHEAT_SETTINGS; index++)
+		{
+			struct cheat_setting *setting = cheat_settings + index;
+			boolean wanted = config_boolean(setting->name)!=0;
+
+			if (setting->wanted && !wanted)
+				setting->clear = TRUE;
+			setting->wanted = wanted;
+		}
+	}
+
+	for (index = 0; index<(short)NUMBER_OF_CHEAT_SETTINGS; index++)
+	{
+		struct cheat_setting *setting = cheat_settings + index;
+
+		if (own_game)
+		{
+			if (setting->wanted)
+				*setting->state = TRUE;
+			else if (setting->clear)
+				*setting->state = FALSE;
+		}
+		setting->clear = FALSE;
+	}
+
+	for (index = 0; index<(short)NUMBER_OF_CHEAT_ACTION_SETTINGS; index++)
+	{
+		struct cheat_action_setting *action = cheat_action_settings + index;
+
+		if (own_game && config_boolean(action->name))
+		{
+			if (!action->done)
+			{
+				action->done = TRUE;
+				action->action();
+				config_write_boolean(action->name, 0);
+			}
+		}
+		else if (!config_boolean(action->name))
+		{
+			action->done = FALSE;
+		}
+	}
+	cheat_port_unit_settings(own_game);
+	if (own_game)
+	{
+		cheat_port_one("cheats.one_weapon", WEAPON_DEFINITION_TAG,
+			cheat_port_weapons, NUMBEROF(cheat_port_weapons), FALSE);
+		cheat_port_one("cheats.one_vehicle", VEHICLE_DEFINITION_TAG,
+			cheat_port_vehicles, NUMBEROF(cheat_port_vehicles), TRUE);
+	}
+
+	return;
+}
