+/*
+TRUCOS_ARMAS.C
+
+TRUCOS, MAS TRUCOS: TRAER ARMAS DE OTRAS MISIONES (cheats.import_weapons). A
+campaign level loads with every campaign weapon it has not got, copied from
+the other campaign maps, so that UN ARMA and TODAS LAS ARMAS can give any of
+them.
+
+And ARMAS AL EMPEZAR (cheats.loadout_ask, Content Evolved's randomizer's
+PLAYER LOADOUT): after the difficulty, a screen of the weapons the player
+starts the level with (menu_functions.c): the mission's (cheats.loadout
+"mission"), two chosen ("set": cheats.loadout_primary and
+cheats.loadout_secondary, which can be none) or two at random ("random");
+those the level has not got copied as TRAER ARMAS's are. players.c's
+player_add_equipment gives them in the starting profile's weapons' place.
+
+The copying is Halo Content Evolved's (Watanoge/halo-content-evolved, GNU
+AGPL v3): its tag packs (tag_pack.c, port_tag_packs.c: the campaign maps'
+tag sections written once, at the main menu, into tag_pack/trucos_armas.pack)
+and its tag importer (tag_import.c: as a level loads, the tags asked for are
+read from the pack with every tag they name, copied, and added to the
+level's tag table). Tags are only ever added as a level loads: a checkpoint
+reverted does not bring them, a level started or restarted does.
+
+This file is the rest Content Evolved's build has elsewhere: the pack's
+manifest (its tools/embed_assets.py embeds port/assets/tag_packs), the
+manifests' conditions (none here) and the read-ahead its file layer has.
+*/
+
+#include "cseries.h"
+
+#include "tag_import.h"
+#include "tag_pack.h"
+#include "../src/port_tag_packs.h"
+
+#include "game/game_engine.h"
+#include "cseries/cseries_windows.h"
+#include "cache/cache_files.h"
+#include "tag_files/tag_groups.h"
+#include "tag_files/tag_files.h"
+#include "networking/network_game_globals.h"
+#include "objects/objects.h"
+#include "units/units.h"
+#include "interface/terminal.h"
+
+extern void *cache_files_tag_instances(long *count);
+
+/* (the loaded map's tag: struct cache_file_tag_instance, tag_groups.h's in GOAT H1) */
+extern int config_boolean(char const *name);
+extern char const *config_string(char const *name);
+extern void platform_log(char const *format, ...);
+
+#define TRUCOS_ARMAS_PACK "trucos_armas"
+
+/* ---------- the pack's manifest (port_tag_packs.c's format) */
+
+/* the weapons' and their effects', sounds' and HUDs' pixels and samples; a
+copied bitmap the pack has not got is read from its map as the level loads */
+static char const trucos_armas_manifest[] =
+	"name = \"trucos_armas\"\n"
+	"version = 1\n"
+	"legacy_file_names = []\n"
+	"maps = [\"a10\", \"a30\", \"a50\", \"b30\", \"b40\", \"c10\", \"c20\", \"c40\", \"d20\", \"d40\"]\n"
+	"minimum_bitmaps = 1\n"
+	"minimum_sounds = 0\n"
+	"wanted = [\"setting:cheats.import_weapons\"]\n"
+	"\n"
+	"[keep]\n"
+	"include_prefixes = [\"weapons\\\\\", \"effects\\\\\", \"ui\\\\hud\\\\\", \"sound\\\\sfx\\\\weapons\\\\\", "
+		"\"sound\\\\sfx\\\\impulse\\\\\"]\n"
+	"exclude_contains = []\n"
+	"exclude_bitmap_prefixes = []\n"
+	"exclude_sound_prefixes = []\n"
+	"\n"
+	"[text]\n"
+	"notice = \"TRAER ARMAS necesita sacar\\nlas armas de los mapas de\\nla campana: unos minutos,\\nuna sola vez. Empieza al cerrar esto.\"\n"
+	"building = \"Sacando las armas\\nde los mapas:\\n\"\n"
+	"ready = \"Las armas de otras misiones estan listas.\"\n"
+	"failed = \"No se pudieron sacar las armas\\n(memoria llena?). Las misiones\\ncargan sin ellas hasta tenerlas.\"\n";
+
+const struct tag_pack_manifest_embedded tag_pack_manifests_embedded[] =
+{
+	{ "trucos_armas.toml", (const unsigned int *)trucos_armas_manifest, sizeof(trucos_armas_manifest) - 1 },
+};
+const unsigned int tag_pack_manifests_embedded_count = 1;
+
+/* a manifest's "condition:<name>": none here */
+struct tag_pack_condition const tag_pack_conditions[] =
+{
+	{ NULL, NULL },
+};
+
+/* Content Evolved's file layer reads a file ahead of its reader; this one's
+reads as it is asked */
+void platform_file_read_ahead(void *file)
+{
+	(void)file;
+	return;
+}
+
+/* ---------- a level's weapons */
+
+/* the campaign's maps, in the order they are looked in for a weapon */
+static char const *const trucos_armas_maps[] =
+{
+	"a10", "a30", "a50", "b30", "b40", "c10", "c20", "c40", "d20", "d40",
+};
+
+/* the campaign's weapons */
+static char const *const trucos_armas_weapons[] =
+{
+	"weapons\\pistol\\pistol",
+	"weapons\\assault rifle\\assault rifle",
+	"weapons\\shotgun\\shotgun",
+	"weapons\\sniper rifle\\sniper rifle",
+	"weapons\\rocket launcher\\rocket launcher",
+	"weapons\\flamethrower\\flamethrower",
+	"weapons\\plasma pistol\\plasma pistol",
+	"weapons\\plasma rifle\\plasma rifle",
+	"weapons\\needler\\needler",
+	"weapons\\plasma_cannon\\plasma_cannon",
+	"weapons\\fuel rod gun\\fuel rod",
+	"weapons\\energy sword\\energy sword",
+};
+
+#define TRUCOS_ARMAS_WEAPON_COUNT (sizeof(trucos_armas_weapons) / sizeof(trucos_armas_weapons[0]))
+#define TRUCOS_ARMAS_MAP_COUNT (sizeof(trucos_armas_maps) / sizeof(trucos_armas_maps[0]))
+
+static int trucos_armas_imported;
+/* the tags copied into the level, as a saved game's key
+(trucos_armas_saved_game_key): 0 with none */
+static unsigned long trucos_armas_key;
+
+/* ARMAS AL EMPEZAR's choices (tools/port_settings.py's cheats_armas_inicio):
+their settings' values and their weapons' folders, those of UN ARMA
+(cheats.c's cheat_port_weapons), all of them: a weapon is the first 'weap'
+whose name has one of its folders, the first folder first */
+static struct
+{
+	char const *value;
+	char const *folders[2];
+	char const *shown;
+} const trucos_armas_loadout_choices[] =
+{
+	{ "pistol", { "weapons\\pistol\\", NULL }, "PISTOLA" },
+	{ "assault_rifle", { "weapons\\assault rifle\\", NULL }, "RIFLE DE ASALTO" },
+	{ "shotgun", { "weapons\\shotgun\\", NULL }, "ESCOPETA" },
+	{ "sniper_rifle", { "weapons\\sniper rifle\\", NULL }, "FRANCOTIRADOR" },
+	{ "rocket_launcher", { "weapons\\rocket launcher\\", NULL }, "LANZACOHETES" },
+	{ "flamethrower", { "weapons\\flamethrower\\", NULL }, "LANZALLAMAS" },
+	{ "plasma_pistol", { "weapons\\plasma pistol\\", NULL }, "PISTOLA PLASMA" },
+	{ "plasma_rifle", { "weapons\\plasma rifle\\", NULL }, "RIFLE PLASMA" },
+	{ "needler", { "weapons\\needler\\", NULL }, "NEEDLER" },
+	{ "fuel_rod", { "weapons\\fuel rod gun\\", "weapons\\plasma_cannon\\" }, "CANON COMBUSTIBLE" },
+	/* (the Elites': the player cannot hold it, and has another weapon in its
+	place, but its player wants it in the list) */
+	{ "energy_sword", { "weapons\\energy sword\\", NULL }, "ESPADA DE ENERGIA" },
+};
+
+#define TRUCOS_ARMAS_LOADOUT_CHOICES ((int)(sizeof(trucos_armas_loadout_choices) / sizeof(trucos_armas_loadout_choices[0])))
+
+/* the level's ARMAS AL EMPEZAR, as it loaded: the two weapons' choices (NONE:
+none) and definitions (NONE: the level has not got it) */
+static struct
+{
+	int choices[2];
+	long weapons[2];
+	int ready;
+	/* what the player is told as the level starts (trucos_armas_loadout_tell):
+	the level was one of ARMAS AL EMPEZAR's, its weapons' pack was not
+	written yet, and whether it has been told */
+	int asked;
+	int pack_missing;
+	int told;
+	/* (ESCOGER ARMAS AL EMPEZAR on, LAS DE LA MISION chosen) */
+	int mission;
+} trucos_armas_loadout;
+
+/* a tag's name has the folder (as cheats.c's cheat_port_name_has) */
+static int trucos_armas_name_has(char const *name, char const *folder)
+{
+	for (; name && *name; name++)
+	{
+		int index;
+
+		for (index = 0; folder[index] && name[index] && (name[index] | 0x20) == (folder[index] | 0x20); index++)
+			;
+		if (!folder[index])
+			return 1;
+	}
+	return 0;
+}
+
+/* the weapon's name is one of the choice's */
+static int trucos_armas_choice_has(int choice, char const *name)
+{
+	int folder;
+
+	for (folder = 0; choice != NONE && folder < 2; folder++)
+	{
+		char const *at = trucos_armas_loadout_choices[choice].folders[folder];
+
+		if (at && trucos_armas_name_has(name, at))
+			return 1;
+	}
+	return 0;
+}
+
+/* the level's weapon of the choice, NONE when it has none */
+static long trucos_armas_choice_weapon(int choice)
+{
+	int folder;
+
+	for (folder = 0; choice != NONE && folder < 2; folder++)
+	{
+		char const *at = trucos_armas_loadout_choices[choice].folders[folder];
+		struct tag_iterator iterator;
+		long tag_index;
+
+		if (!at)
+			continue;
+		tag_iterator_new(&iterator, 'weap');
+		for (tag_index = tag_iterator_next(&iterator); tag_index != NONE; tag_index = tag_iterator_next(&iterator))
+		{
+			if (trucos_armas_name_has(tag_get_name(tag_index), at))
+				return tag_index;
+		}
+	}
+	return NONE;
+}
+
+static int trucos_armas_campaign_map(char const *scenario_name)
+{
+	unsigned long index;
+
+	for (index = 0; index < TRUCOS_ARMAS_MAP_COUNT; index++)
+	{
+		if (!_stricmp(scenario_name, trucos_armas_maps[index]))
+			return 1;
+	}
+	return 0;
+}
+
+/* menu_functions.c: a level's path (levels\a10\a10) or name (a10) is a
+campaign level's, the levels ARMAS AL EMPEZAR is for */
+int trucos_armas_campaign_level(char const *path)
+{
+	char const *leaf = path;
+	char const *at;
+
+	if (!path)
+		return 0;
+	for (at = path; *at; at++)
+	{
+		if (*at == '\\' || *at == '/')
+			leaf = at + 1;
+	}
+	return trucos_armas_campaign_map(leaf);
+}
+
+/* ARMAS AL EMPEZAR copies weapons (not the mission's own) */
+static int trucos_armas_loadout_chosen(void)
+{
+	char const *mode = config_string("cheats.loadout");
+
+	return config_boolean("cheats.loadout_ask") && mode && (!_stricmp(mode, "set") || !_stricmp(mode, "random"));
+}
+
+/* a setting's choice, NONE for none or another word */
+static int trucos_armas_loadout_choice(char const *value)
+{
+	int index;
+
+	for (index = 0; value && index < TRUCOS_ARMAS_LOADOUT_CHOICES; index++)
+	{
+		if (!_stricmp(value, trucos_armas_loadout_choices[index].value))
+			return index;
+	}
+	return NONE;
+}
+
+/* the level's two: the settings' ("set"), or two different ones at random
+("random", again each time a level loads) */
+static void trucos_armas_loadout_choose(void)
+{
+	char const *mode = config_string("cheats.loadout");
+
+	trucos_armas_loadout.choices[0] = NONE;
+	trucos_armas_loadout.choices[1] = NONE;
+	if (!trucos_armas_loadout_chosen())
+		return;
+	if (!_stricmp(mode, "random"))
+	{
+		unsigned long seed = system_milliseconds() * 2654435761UL;
+		int first = (int)((seed >> 7) % TRUCOS_ARMAS_LOADOUT_CHOICES);
+		int second = (int)((first + 1 + (seed >> 17) % (TRUCOS_ARMAS_LOADOUT_CHOICES - 1)) % TRUCOS_ARMAS_LOADOUT_CHOICES);
+
+		trucos_armas_loadout.choices[0] = first;
+		trucos_armas_loadout.choices[1] = second;
+		return;
+	}
+	trucos_armas_loadout.choices[0] = trucos_armas_loadout_choice(config_string("cheats.loadout_primary"));
+	trucos_armas_loadout.choices[1] = trucos_armas_loadout_choice(config_string("cheats.loadout_secondary"));
+	if (trucos_armas_loadout.choices[1] == trucos_armas_loadout.choices[0])
+		trucos_armas_loadout.choices[1] = NONE;
+	return;
+}
+
+/* (with the level's tags all in) the two weapons' definitions */
+static void trucos_armas_loadout_resolve(char const *scenario_name)
+{
+	int index;
+
+	trucos_armas_loadout.ready = 0;
+	for (index = 0; index < 2; index++)
+	{
+		int choice = trucos_armas_loadout.choices[index];
+
+		trucos_armas_loadout.weapons[index] = trucos_armas_choice_weapon(choice);
+		if (trucos_armas_loadout.weapons[index] != NONE)
+		{
+			trucos_armas_loadout.ready = 1;
+			platform_log("trucos: ARMAS AL EMPEZAR: %s", tag_get_name(trucos_armas_loadout.weapons[index]));
+		}
+		else if (choice != NONE)
+		{
+			platform_log("trucos: ARMAS AL EMPEZAR: %s has not got %s", scenario_name,
+				trucos_armas_loadout_choices[choice].value);
+		}
+	}
+	return;
+}
+
+/* menu_functions.c's "trucos armas empezar" (the screen's OK): whether the
+game can start. Weapons to copy and their pack not written: asked for, and
+written now, at the main menu (its checklist), and OK pressed again */
+int trucos_armas_loadout_start(void)
+{
+	if (!trucos_armas_loadout_chosen() || tag_pack_ready(TRUCOS_ARMAS_PACK))
+		return 1;
+	tag_pack_request(TRUCOS_ARMAS_PACK);
+	return !tag_pack_busy();
+}
+
+/* the first time the player is given its weapons in a level of ARMAS AL
+EMPEZAR's: on the screen, the weapons it starts with, or why it has not got
+them */
+static void trucos_armas_loadout_tell(long given)
+{
+	char text[160];
+	int slot;
+
+	if (trucos_armas_loadout.told || (!trucos_armas_loadout.asked && !trucos_armas_loadout.mission))
+		return;
+	trucos_armas_loadout.told = 1;
+	if (trucos_armas_loadout.mission)
+	{
+		terminal_printf(global_real_argb_orange, "ARMAS AL EMPEZAR: las de la mision");
+		return;
+	}
+	if (given > 0)
+	{
+		text[0] = 0;
+		for (slot = 0; slot < 2; slot++)
+		{
+			if (trucos_armas_loadout.weapons[slot] == NONE)
+				continue;
+			if (text[0])
+				strncat(text, " Y ", sizeof(text) - strlen(text) - 1);
+			strncat(text, trucos_armas_loadout_choices[trucos_armas_loadout.choices[slot]].shown,
+				sizeof(text) - strlen(text) - 1);
+		}
+		terminal_printf(global_real_argb_orange, "ARMAS AL EMPEZAR: %s", text);
+	}
+	for (slot = 0; slot < 2; slot++)
+	{
+		int choice = trucos_armas_loadout.choices[slot];
+
+		if (choice == NONE || trucos_armas_loadout.weapons[slot] != NONE)
+			continue;
+		terminal_printf(global_real_argb_orange, trucos_armas_loadout.pack_missing ?
+			"ARMAS AL EMPEZAR: esta mision no trae %s. Faltan las armas de otras misiones: sal al menu principal, espera que las saque y empieza otra vez" :
+			"ARMAS AL EMPEZAR: no se encontro %s en ningun mapa", trucos_armas_loadout_choices[choice].shown);
+	}
+	if (given == 0 && trucos_armas_loadout.ready)
+		terminal_printf(global_real_argb_orange, "ARMAS AL EMPEZAR: no se pudieron dar las armas");
+	return;
+}
+
+/* players.c's player_add_equipment: the level's two weapons given in the
+starting profile's weapons' place (1: given, or the player keeps what it has
+when a script's weapons are added to them) */
+int trucos_armas_player_loadout(long unit_index, int reset_equipment)
+{
+	struct unit_datum *unit;
+	int first = 1;
+	int index;
+	long given = 0;
+
+	if (game_engine_running() || network_game_distributed_client())
+		return 0;
+	if (!trucos_armas_loadout.ready)
+	{
+		trucos_armas_loadout_tell(-1);
+		return 0;
+	}
+	unit = unit_try_and_get(unit_index);
+	if (!unit || unit->unit.player_index == NONE)
+		return 0;
+	if (!reset_equipment && unit_get_weapon_count(unit_index) > 0)
+		return 1;
+	for (index = 0; index < 2; index++)
+	{
+		struct object_placement_data placement_data;
+		long weapon_index;
+
+		if (trucos_armas_loadout.weapons[index] == NONE)
+			continue;
+		object_placement_data_new(&placement_data, trucos_armas_loadout.weapons[index], unit_index);
+		weapon_index = object_new(&placement_data);
+		if (weapon_index == NONE)
+			continue;
+		if (unit_add_weapon_to_inventory(unit_index, weapon_index, first ? _unit_add_weapon_starting : _unit_add_weapon_normal))
+		{
+			first = 0;
+			given++;
+		}
+		else
+		{
+			platform_log("trucos: ARMAS AL EMPEZAR: %s could not be given", tag_get_name(trucos_armas_loadout.weapons[index]));
+			object_delete(weapon_index);
+		}
+	}
+	trucos_armas_loadout_tell(given);
+	/* (none given: the profile's, as without ARMAS AL EMPEZAR) */
+	return given > 0;
+}
+
+/* game_state.c: the tags copied into the level, which its saved game's map
+checksum is mixed with. A saved game of the level with other tags copied
+(TRAER ARMAS or ESCOGER ARMAS AL EMPEZAR on in one game and not in the other)
+has other tag indices in it, and is not taken, as one of another map */
+unsigned long trucos_armas_saved_game_key(void)
+{
+	return trucos_armas_key;
+}
+
+/* the names of the tags from first on (those copied), and how many */
+static unsigned long trucos_armas_tags_key(long first)
+{
+	struct cache_file_tag_instance *instances;
+	unsigned long key = 2166136261UL;
+	long count = 0;
+	long index;
+
+	instances = cache_files_tag_instances(&count);
+	if (!instances || count <= first)
+		return 0;
+	for (index = first; index < count; index++)
+	{
+		char const *name = instances[index].name;
+
+		key = (key ^ (unsigned long)instances[index].group_tag) * 16777619UL;
+		for (; name && *name; name++)
+			key = (key ^ (unsigned char)*name) * 16777619UL;
+	}
+	key = (key ^ (unsigned long)(count - first)) * 16777619UL;
+	return key ? key : 1;
+}
+
+/* cache_files.c, as a level's tags have loaded: before the menus' and the
+mods' tags, which go after these. The weapons the level has not got: every
+campaign weapon with TRAER ARMAS, ARMAS AL EMPEZAR's two with that */
+void trucos_armas_tags_loaded(char const *scenario_name)
+{
+	char wanted[TRUCOS_ARMAS_WEAPON_COUNT];
+	int needed[2];
+	unsigned long weapon, map;
+	long left = 0, asked = 0, before = 0;
+	int all, slot;
+
+	trucos_armas_loadout.ready = 0;
+	trucos_armas_loadout.asked = 0;
+	trucos_armas_loadout.pack_missing = 0;
+	trucos_armas_loadout.told = 0;
+	trucos_armas_loadout.mission = 0;
+	trucos_armas_key = 0;
+	if (!scenario_name || !trucos_armas_campaign_map(scenario_name))
+		return;
+	/* every campaign weapon the level has not got, with TRAER ARMAS or ESCOGER
+	ARMAS AL EMPEZAR (whichever weapons are chosen, LAS DE LA MISION too): the
+	same tags each time the level loads, so that its saved game is the
+	level's again (trucos_armas_saved_game_key) */
+	all = config_boolean("cheats.import_weapons") || config_boolean("cheats.loadout_ask");
+	trucos_armas_loadout_choose();
+	trucos_armas_loadout.asked = trucos_armas_loadout_chosen();
+	trucos_armas_loadout.mission = !trucos_armas_loadout.asked && config_boolean("cheats.loadout_ask");
+	platform_log("trucos: ARMAS AL EMPEZAR: %s, ask %d, mode %s, %s and %s", scenario_name,
+		config_boolean("cheats.loadout_ask"), config_string("cheats.loadout"), config_string("cheats.loadout_primary"),
+		config_string("cheats.loadout_secondary"));
+	if (!all && trucos_armas_loadout.choices[0] == NONE && trucos_armas_loadout.choices[1] == NONE)
+		return;
+	for (weapon = 0; weapon < TRUCOS_ARMAS_WEAPON_COUNT; weapon++)
+	{
+		wanted[weapon] = all && tag_loaded('weap', trucos_armas_weapons[weapon]) == NONE;
+		left += wanted[weapon];
+	}
+	/* ARMAS AL EMPEZAR's two the level has not got, by their folders, when
+	not among those copied by their names already */
+	for (slot = 0; slot < 2; slot++)
+	{
+		int choice = trucos_armas_loadout.choices[slot];
+
+		needed[slot] = choice != NONE && trucos_armas_choice_weapon(choice) == NONE;
+		for (weapon = 0; needed[slot] && weapon < TRUCOS_ARMAS_WEAPON_COUNT; weapon++)
+		{
+			if (wanted[weapon] && trucos_armas_choice_has(choice, trucos_armas_weapons[weapon]))
+				needed[slot] = 0;
+		}
+		left += needed[slot];
+	}
+	if (!left)
+	{
+		trucos_armas_loadout_resolve(scenario_name);
+		return;
+	}
+	if (!tag_pack_ready(TRUCOS_ARMAS_PACK))
+	{
+		/* (written at the main menu, now that it is wanted) */
+		tag_pack_request(TRUCOS_ARMAS_PACK);
+		platform_log("trucos: TRAER ARMAS: the pack is not written yet; %s loads without them", scenario_name);
+		trucos_armas_loadout.pack_missing = 1;
+		trucos_armas_loadout_resolve(scenario_name);
+		return;
+	}
+	cache_files_tag_instances(&before);
+	if (!tag_import_begin())
+	{
+		trucos_armas_loadout_resolve(scenario_name);
+		return;
+	}
+	for (map = 0; map < TRUCOS_ARMAS_MAP_COUNT && left > 0; map++)
+	{
+		struct tag_import_donor *donor;
+		long index, count;
+
+		if (!_stricmp(scenario_name, trucos_armas_maps[map]))
+			continue;
+		donor = tag_import_open(TRUCOS_ARMAS_PACK, trucos_armas_maps[map]);
+		if (!donor)
+			continue;
+		count = tag_import_tag_count(donor);
+		for (index = 0; index < count && left > 0; index++)
+		{
+			char const *name;
+			int take = 0;
+
+			if (tag_import_tag_group(donor, index) != 'weap')
+				continue;
+			name = tag_import_tag_name(donor, index);
+			if (!name)
+				continue;
+			for (weapon = 0; weapon < TRUCOS_ARMAS_WEAPON_COUNT; weapon++)
+			{
+				if (wanted[weapon] && !_stricmp(name, trucos_armas_weapons[weapon]))
+				{
+					wanted[weapon] = 0;
+					left--;
+					take = 1;
+					break;
+				}
+			}
+			for (slot = 0; slot < 2; slot++)
+			{
+				if (needed[slot] && trucos_armas_choice_has(trucos_armas_loadout.choices[slot], name))
+				{
+					needed[slot] = 0;
+					left--;
+					take = 1;
+				}
+			}
+			if (take && tag_import_want(donor, index))
+			{
+				asked++;
+				platform_log("trucos: TRAER ARMAS: %s from %s", name, trucos_armas_maps[map]);
+			}
+		}
+		tag_import_release(donor);
+	}
+	if (asked)
+	{
+		tag_import_run();
+		tag_import_log("trucos");
+		trucos_armas_imported = 1;
+	}
+	tag_import_end();
+	trucos_armas_key = asked ? trucos_armas_tags_key(before) : 0;
+	trucos_armas_loadout_resolve(scenario_name);
+	return;
+}
+
+/* cache_files.c, as the level goes: its own table back */
+void trucos_armas_tags_unloaded(void)
+{
+	trucos_armas_loadout.ready = 0;
+	trucos_armas_key = 0;
+	if (!trucos_armas_imported)
+		return;
+	tag_import_level_unloaded();
+	trucos_armas_imported = 0;
+	return;
+}
