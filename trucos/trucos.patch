+short hs_port_guide_get_target_order(void);
+short hs_port_guide_get_ai_waits(long const **references, short const **orders);
+char const *hs_port_guide_step_text(short step);
+
+/* the objective's volume (its middle), for the route's floor */
+static boolean hud_port_guide_target_is_volume = FALSE;
+static real_point3d hud_port_guide_target_center;
+
+/* what the arrow points at: AUTO's color and lines */
+enum
+{
+	_hud_port_guide_none = 0,
+	_hud_port_guide_place, /* where the level waits for the player to go */
+	_hud_port_guide_step_enemy, /* one of the enemies the level waits to die */
+	_hud_port_guide_weapon, /* a weapon with ammo, the player's are empty */
+	_hud_port_guide_enemy,
+	_hud_port_guide_ally
+};
+static short hud_port_guide_kind = _hud_port_guide_none;
+static short hud_port_guide_kind_before = _hud_port_guide_none; /* (the last time's) */
+static short hud_port_guide_remaining = 0; /* (the step's enemies left) */
+static char const *hud_port_guide_text = NULL; /* (what to do at the step) */
+
+/* the allegiance table's teams (game_allegiance.c's NUMBER_OF_GAME_TEAMS) */
+#define GUIDE_GAME_TEAMS 10
+/* (AUTO: how near a weapon is looked for when the player's are empty, and how
+near the enemies a step waits to die must be to be pointed at before the place:
+world units, 3.048 meters) */
+#define GUIDE_WEAPON_SEARCH_DISTANCE 25.f
+#define GUIDE_STEP_ENEMY_DISTANCE 25.f
+#define GUIDE_STEP_ENEMY_DISTANCE_LEAVE 30.f /* (once pointed at, until this far) */
+
+static boolean hud_port_guide_nearest_unit(
+	long unit_index,
+	boolean enemy,
+	real_point3d *target,
+	long *target_object_index)
+{
+	struct object_iterator iterator;
+	real_point3d origin;
+	short team = object_get(unit_index)->object.owner_team_index;
+	long best_index = NONE;
+	real best_distance_squared = 0.f;
+
+	object_get_origin(unit_index, &origin);
+	object_iterator_new(&iterator, _object_mask_biped, 0);
+	while (object_iterator_next(&iterator))
+	{
+		struct object_datum *object = object_get(iterator.index);
+
+		/* (an ally is any living unit that is not an enemy: the marines are not always
+		allied to the player's team by the allegiance table, but are not its enemies) */
+		if (iterator.index!=unit_index && !TEST_FLAG(object->object.damage_flags, _object_dead_bit) &&
+			VALID_INDEX(object->object.owner_team_index, GUIDE_GAME_TEAMS) &&
+			enemy == (game_team_is_enemy(team, object->object.owner_team_index)!=FALSE))
+		{
+			real_point3d position;
+			real distance_squared;
+
+			object_get_origin(iterator.index, &position);
+			distance_squared = distance_squared3d(&origin, &position);
+			/* an ally next to the player is already in sight */
+			if ((enemy || distance_squared>16.f) && (best_index==NONE || distance_squared<best_distance_squared))
+			{
+				best_index = iterator.index;
+				best_distance_squared = distance_squared;
+			}
+		}
+	}
+
+	if (best_index!=NONE)
+	{
+		real radius;
+
+		object_get_bounding_sphere(best_index, target, &radius);
+		*target_object_index = best_index;
+	}
+
+	return best_index!=NONE;
+}
+
+/* the nearest living enemy of the AI a step waits to die (an encounter, a
+squad, a platoon), and how many of it are left */
+static boolean hud_port_guide_step_enemy(
+	long unit_index,
+	long ai_reference,
+	real_point3d *target,
+	long *target_object_index,
+	short *remaining,
+	real *distance_squared_result)
+{
+	struct ai_script_actor_reference_iterator iterator;
+	struct actor_datum *actor;
+	real_point3d origin;
+	short team = object_get(unit_index)->object.owner_team_index;
+	long best_index = NONE;
+	real best_distance_squared = 0.f;
+	short count = 0, actors = 0;
+
+	object_get_origin(unit_index, &origin);
+	ai_index_actor_iterator_new(ai_reference, &iterator);
+	while ((actor = ai_index_actor_iterator_next(&iterator))!=NULL && actors++<256)
+	{
+		long index = actor->meta.unit_index;
+		struct object_datum *object = index==NONE ? NULL : object_try_and_get_and_verify_type(index, _object_mask_unit);
+
+		if (object && index!=unit_index && !TEST_FLAG(object->object.damage_flags, _object_dead_bit) &&
+			VALID_INDEX(object->object.owner_team_index, GUIDE_GAME_TEAMS) &&
+			game_team_is_enemy(team, object->object.owner_team_index))
+		{
+			real_point3d position;
+			real distance_squared;
+
+			count++;
+			object_get_origin(index, &position);
+			distance_squared = distance_squared3d(&origin, &position);
+			if (best_index==NONE || distance_squared<best_distance_squared)
+			{
+				best_index = index;
+				best_distance_squared = distance_squared;
+			}
+		}
+	}
+
+	if (best_index!=NONE)
+	{
+		real radius;
+
+		object_get_bounding_sphere(best_index, target, &radius);
+		*target_object_index = best_index;
+		*remaining = count;
+		*distance_squared_result = best_distance_squared;
+	}
+
+	return best_index!=NONE;
+}
+
+/* whether a weapon has no rounds left: its magazines empty, or its battery */
+static boolean hud_port_guide_weapon_empty(
+	long weapon_index)
+{
+	struct weapon_datum *weapon = weapon_get(weapon_index);
+	struct weapon_definition *definition = weapon_definition_get(weapon->definition_index);
+	boolean empty = TRUE;
+	short magazine_index;
+
+	if (definition->weapon.magazines.count<=0)
+		return weapon->weapon.age>=1.f;
+	for (magazine_index = 0; magazine_index<MIN(definition->weapon.magazines.count, 2); magazine_index++)
+	{
+		struct weapon_magazine const *magazine = &weapon->weapon.magazines[magazine_index];
+
+		if (magazine->rounds_loaded>0 || magazine->rounds_total>0)
+			empty = FALSE;
+	}
+
+	return empty;
+}
+
+/* whether the weapon in the player's hand is empty (the arrow shows one to
+take instead; none in the hand: not) */
+static boolean hud_port_guide_out_of_ammo(
+	long unit_index)
+{
+	struct unit_datum *unit = unit_get(unit_index);
+	short weapon_slot = unit->unit.current_weapon_index;
+	long weapon_index;
+
+	if (weapon_slot<0 || weapon_slot>=MAXIMUM_WEAPONS_PER_UNIT)
+		return FALSE;
+	weapon_index = unit->unit.weapon_object_indices[weapon_slot];
+
+	return weapon_index!=NONE && object_try_and_get_and_verify_type(weapon_index, _object_mask_weapon) &&
+		hud_port_guide_weapon_empty(weapon_index);
+}
+
+/* the nearest weapon on the ground with rounds in it */
+static boolean hud_port_guide_nearest_weapon(
+	long unit_index,
+	real_point3d *target,
+	long *target_object_index)
+{
+	struct object_iterator iterator;
+	real_point3d origin;
+	long best_index = NONE;
+	real best_distance_squared = GUIDE_WEAPON_SEARCH_DISTANCE*GUIDE_WEAPON_SEARCH_DISTANCE;
+
+	object_get_origin(unit_index, &origin);
+	object_iterator_new(&iterator, _object_mask_weapon, 0);
+	while (object_iterator_next(&iterator))
+	{
+		struct object_datum *object = object_get(iterator.index);
+
+		if (object->object.parent_object_index==NONE && !hud_port_guide_weapon_empty(iterator.index))
+		{
+			real_point3d position;
+			real distance_squared;
+
+			object_get_origin(iterator.index, &position);
+			distance_squared = distance_squared3d(&origin, &position);
+			if (distance_squared<best_distance_squared)
+			{
+				best_index = iterator.index;
+				best_distance_squared = distance_squared;
+			}
+		}
+	}
+
+	if (best_index!=NONE)
+	{
+		real radius;
+
+		object_get_bounding_sphere(best_index, target, &radius);
+		*target_object_index = best_index;
+	}
+
+	return best_index!=NONE;
+}
+
+static boolean hud_port_guide_target(
+	long unit_index,
+	real_point3d *target,
+	long *target_object_index)
+{
+	static unsigned long changes = 0;
+	static boolean read = FALSE;
+	static short mode = 0; /* 0 off, 1 ally, 2 enemy, 3 objective, 4 auto */
+	real_point3d origin;
+
+	if (!read || changes!=config_changes())
+	{
+		char const *word = config_string("guide.mode");
+
+		read = TRUE;
+		changes = config_changes();
+		mode = !strcmp(word, "ally") ? 1 : !strcmp(word, "enemy") ? 2 : !strcmp(word, "objective") ? 3 :
+			!strcmp(word, "auto") ? 4 : 0;
+	}
+
+	*target_object_index = NONE;
+	hud_port_guide_target_is_volume = FALSE;
+	hud_port_guide_kind_before = hud_port_guide_kind;
+	hud_port_guide_kind = _hud_port_guide_none;
+	hud_port_guide_text = NULL;
+	if (mode==0)
+		return FALSE;
+
+	object_get_origin(unit_index, &origin);
+	/* AUTO: with the weapon in hand empty, a weapon first */
+	if (mode==4 && hud_port_guide_out_of_ammo(unit_index) &&
+		hud_port_guide_nearest_weapon(unit_index, target, target_object_index))
+	{
+		hud_port_guide_kind = _hud_port_guide_weapon;
+	}
+	else if (mode==3 || mode==4)
+	{
+		short what = hs_port_guide_find_target(&origin, target, mode==4);
+		short step = what ? hs_port_guide_get_target_order() : NONE;
+
+		if (what)
+		{
+			hud_port_guide_kind = _hud_port_guide_place;
+			hud_port_guide_target_is_volume = TRUE;
+			hs_port_guide_get_target_center(&hud_port_guide_target_center);
+		}
+		/* AUTO: the enemies a step waits to die, the nearest of them, when they
+		are near or there is no place to go: the level goes on when they are dead */
+		if (mode==4)
+		{
+			long const *references;
+			short const *orders;
+			short count = hs_port_guide_get_ai_waits(&references, &orders);
+			short index, best = NONE, best_remaining = 0;
+			real best_distance_squared = 0.f;
+			real_point3d best_target;
+			long best_object_index = NONE;
+			/* (once pointed at, until a little farther: the arrow does not flicker) */
+			real distance = hud_port_guide_kind_before==_hud_port_guide_step_enemy ?
+				GUIDE_STEP_ENEMY_DISTANCE_LEAVE : GUIDE_STEP_ENEMY_DISTANCE;
+
+			for (index = 0; index<count; index++)
+			{
+				real_point3d enemy;
+				long enemy_index;
+				short remaining;
+				real distance_squared;
+
+				if (hud_port_guide_step_enemy(unit_index, references[index], &enemy, &enemy_index, &remaining,
+						&distance_squared) &&
+					(best==NONE || distance_squared<best_distance_squared))
+				{
+					best = index;
+					best_distance_squared = distance_squared;
+					best_target = enemy;
+					best_object_index = enemy_index;
+					best_remaining = remaining;
+				}
+			}
+			if (best!=NONE && (!what || best_distance_squared<=distance*distance))
+			{
+				*target = best_target;
+				*target_object_index = best_object_index;
+				hud_port_guide_remaining = best_remaining;
+				hud_port_guide_kind = _hud_port_guide_step_enemy;
+				hud_port_guide_target_is_volume = FALSE;
+				step = orders[best];
+			}
+		}
+		hud_port_guide_text = hs_port_guide_step_text(step);
+	}
+	/* AUTO: else the nearest enemy */
+	if (hud_port_guide_kind==_hud_port_guide_none && (mode==1 || mode==2 || mode==4) &&
+		hud_port_guide_nearest_unit(unit_index, mode!=1, target, target_object_index))
+	{
+		hud_port_guide_kind = mode==1 ? _hud_port_guide_ally : _hud_port_guide_enemy;
+	}
+
+	/* (each change of what it points at, to debug.txt) */
+	{
+		static short logged_mode = NONE, logged_kind = NONE, lines = 0;
+
+		if ((mode!=logged_mode || hud_port_guide_kind!=logged_kind) && lines<200)
+		{
+			static char const *const kinds[] =
+				{ "nothing", "the objective's place", "the enemies the level waits to die", "a weapon (the one in hand is empty)",
+				"the nearest enemy", "the nearest ally" };
+			static char const *const modes[] = { "off", "ally", "enemy", "objective", "auto" };
+
+			lines++;
+
+			error(_error_silent, "guide arrow (%s): points at %s", modes[mode], kinds[hud_port_guide_kind]);
+			logged_mode = mode;
+			logged_kind = hud_port_guide_kind;
+		}
+	}
+
+	return hud_port_guide_kind!=_hud_port_guide_none;
+}
+
+/* port: the guide arrow's route (the GPS). The arrow does not point through the
+walls: it asks the AI's pathfinder (ai/path.c, what the marines and the covenant
+walk with) for the way to the target over the level's floor, and points to the
+next corner of it. The route is found again every few ticks, or when the target
+moves; between those the arrow moves on to the next corner as the player passes
+one. With no way (the target on another part of the level that is not loaded,
+in the air, or too far for the search), it points straight at the target as
+before. Distances are in world units (3.048 meters). */
+#define GUIDE_ROUTE_REFRESH_TICKS 10
+#define GUIDE_ROUTE_MINIMUM_TICKS 3
+#define GUIDE_ROUTE_CORNER_REACHED 0.5f
+#define GUIDE_ROUTE_CORNER_REACHED_RIDING 1.5f
+#define GUIDE_ROUTE_TARGET_MOVED 0.5f
+#define GUIDE_ROUTE_ARROW_HEIGHT 0.4f
+#define GUIDE_ROUTE_MAXIMUM_STEPS 4
+#define GUIDE_ROUTE_MAXIMUM_FLOORS 3
+
+struct hud_port_guide_route_datum
+{
+	boolean valid;
+	char status; /* how the route went: S no floor under the player, T none under the
+	target, P the whole way, C part of the way, F and X no way, B the way not built */
+	long time;
+	short structure_bsp_index;
+	real_point3d target;
+	short step_count;
+	real_point3d steps[GUIDE_ROUTE_MAXIMUM_STEPS];
+};
+
+static struct hud_port_guide_route_datum hud_port_guide_routes[4];
+/* (the pathfinder's search: too big for the stack, and one at a time) */
+static struct path_state hud_port_guide_path_state;
+
+
+/* the floor under a point: the level's surface the pathfinder walks on */
+static boolean hud_port_guide_floor(
+	real_point3d const *point,
+	real depth,
+	real_point3d *floor_point,
+	long *surface_index)
+{
+	struct collision_result collision;
+	real_point3d start = *point;
+	real_vector3d down;
+	boolean found = FALSE;
+
+	start.z += 0.1f;
+	down.i = 0.f;
+	down.j = 0.f;
+	down.k = -depth;
+	global_current_collision_users[global_current_collision_user_depth++] = 20;
+	if (collision_test_vector(FLAG(_collision_test_front_facing_surfaces_bit) | FLAG(_collision_test_structure_bit),
+			&start, &down, NONE, &collision) &&
+		collision.type==_collision_result_structure && collision.surface_index!=NONE)
+	{
+		*floor_point = collision.point;
+		*surface_index = collision.surface_index;
+		found = TRUE;
+	}
+	--global_current_collision_user_depth;
+
+	return found;
+}
+
+/* the floors the target can be on, in order: under it; at points nearer the
+middle of the objective's volume (its nearest point to the player is often in
+a wall); then the same from higher up (a target low in a room can be in the
+floor: a ray from inside the level's walls passes through their back faces).
+Returns the candidate_index'th floor found (a different surface each) */
+static boolean hud_port_guide_goal_floor(
+	real_point3d const *target,
+	short candidate_index,
+	real_point3d *floor_point,
+	long *surface_index)
+{
+	static real const heights[3] = { 0.f, 1.f, 3.f };
+	short step_count = hud_port_guide_target_is_volume ? 5 : 1;
+	short step_index, height_index;
+	long found_surfaces[4];
+	short found_count = 0;
+
+	for (height_index = 0; height_index<3; height_index++)
+	{
+		for (step_index = 0; step_index<step_count; step_index++)
+		{
+			real t = step_index/4.f;
+			real_point3d start;
+			real_point3d point;
+			long surface;
+			short index;
+
+			start.x = target->x+(hud_port_guide_target_center.x-target->x)*t;
+			start.y = target->y+(hud_port_guide_target_center.y-target->y)*t;
+			start.z = target->z+(hud_port_guide_target_center.z-target->z)*t+heights[height_index];
+			if (!hud_port_guide_floor(&start, 5.f+2.f*heights[height_index], &point, &surface))
+				continue;
+			for (index = 0; index<found_count && found_surfaces[index]!=surface; index++)
+				;
+			if (index<found_count)
+				continue;
+			if (found_count==candidate_index)
+			{
+				*floor_point = point;
+				*surface_index = surface;
+				return TRUE;
+			}
+			if (found_count<4)
+				found_surfaces[found_count++] = surface;
+		}
+	}
+
+	return FALSE;
+}
+
+/* port: the guide arrow's distance map (the GPS at any distance). The AI's
+pathfinder looks at a fixed number of floor pieces in a search, so a target far
+away is found only part of the way, and that part can lead to a dead end. The
+distance map walks the whole walkable floor of the loaded part of the level
+once for each target, outward from the target's floor (Dijkstra's algorithm),
+a few thousand pieces a tick so that the game never stops, and notes for each
+piece the walking distance to the target and the next piece toward it. The
+arrow then follows that chain from the player's floor some way toward the
+target, and asks the pathfinder only for the short way there. The floor
+pieces, their neighbors and which can be walked are the map's own, those the
+AI walks on (the collision bsp's surfaces and edges, and the structure's
+pathfinding surfaces). Distances are in world units (3.048 meters). */
+#define GUIDE_MAP_STEPS_PER_TICK 1500
+#define GUIDE_MAP_WAYPOINT_DISTANCE 8.f
+#define GUIDE_MAP_TARGET_MOVED 3.f
+#define GUIDE_MAP_MAXIMUM_CANDIDATES 3
+#define GUIDE_MAP_UNSEEN (-1L)
+#define GUIDE_MAP_DONE (-2L)
+#define GUIDE_MAP_FAR 1.0e30f
+#define GUIDE_MAP_WALKABLE_BIT 6 /* (ai/path.c's _pathfinding_surface_walkable_bit) */
+/* a map from a floor under the target that reaches fewer surfaces than this
+(and a tenth of the level's part) is from an island (a roof, a rock): the
+target's next floor is tried */
+#define GUIDE_MAP_ISLAND_SURFACES 2000
+/* the player walks up slopes the AI does not (the map's walkable surfaces
+are the AI's): a surface at most this steep (the cosine of its slope, about
+45 degrees) is walkable too, at a higher cost, so that the AI's ways are
+taken where there are */
+#define GUIDE_MAP_PLAYER_SLOPE 0.7f
+#define GUIDE_MAP_SLOPE_COST 1.5f
+/* and one up to about 60 degrees, which the player walks up slowly, at a
+higher cost still */
+#define GUIDE_MAP_STEEP_SLOPE 0.5f
+#define GUIDE_MAP_STEEP_COST 2.5f
+/* a low wall the player jumps up or drops down (a step, a ledge, a bank
+between two pieces of the terrain): at most this high, in world units (about
+1.5 m up, 6 m down), at twice the cost */
+#define GUIDE_MAP_CLIMB 0.5f
+#define GUIDE_MAP_DROP 2.f
+#define GUIDE_MAP_STEP_COST 2.f
+#define GUIDE_MAP_MAXIMUM_NEIGHBORS 32
+/* a bank of several walls and slopes is crossed through at most this many
+of its surfaces (each edge on the way within the climb and the drop) */
+#define GUIDE_MAP_BANK_SURFACES 3
+#define GUIDE_MAP_BANK_SEARCH 48
+/* the map's most work in a tick, in milliseconds */
+#define GUIDE_MAP_TICK_MILLISECONDS 3
+
+enum
+{
+	_guide_map_none,
+	_guide_map_near,
+	_guide_map_waypoint
+};
+
+static struct
+{
+	/* each surface's walking distance to the target, the next surface toward
+	it, the point it is left by toward it (the middle of the edge to the next
+	one, or the target's floor), and its place in the search's heap (or
+	GUIDE_MAP_UNSEEN, or GUIDE_MAP_DONE once its distance is final) */
+	long capacity;
+	real *distances;
+	long *nexts;
+	real_point3d *anchors;
+	long *places;
+	long *heap;
+	long heap_count;
+	long surface_count;
+	short structure_bsp_index;
+	long goal_surface_index;
+	real_point3d target;
+	short candidate_index;
+	boolean active;
+	boolean complete;
+	long last_tick;
+	long reached_count;
+	long started_tick;
+	unsigned long milliseconds;
+} hud_port_guide_map;
+
+unsigned long system_milliseconds(void); /* (cseries_windows.h) */
+
+/* the walking distance the arrow shows, from the map; negative when the map
+cannot tell */
+static real hud_port_guide_walking_distance = -1.f;
+
+/* what a map is for: the objective's volume (its middle: the point of it
+nearest the player moves as the player does), else the target */
+static real_point3d const *hud_port_guide_map_key(
+	real_point3d const *target)
+{
+	return hud_port_guide_target_is_volume ? &hud_port_guide_target_center : target;
+}
+
+static struct collision_bsp const *hud_port_guide_map_bsp(
+	struct structure_bsp const **structure_result)
+{
+	struct structure_bsp const *structure = global_structure_bsp_get();
+
+	*structure_result = structure;
+	if (!structure || structure->collision_bsp.count<1)
+		return NULL;
+	return TAG_BLOCK_GET_ELEMENT(&structure->collision_bsp, 0, struct collision_bsp);
+}
+
+/* how flat a surface is: the upward part of its plane's normal (1 flat, 0 a
+wall, negative a ceiling) */
+static real hud_port_guide_map_slope(
+	struct collision_bsp const *bsp,
+	long surface_index)
+{
+	struct collision_surface const *surface = TAG_BLOCK_GET_ELEMENT(&bsp->surfaces, surface_index,
+		struct collision_surface);
+	long plane_index = surface->plane_designator & LONG_MAX;
+	real_plane3d const *plane;
+	real up;
+
+	if (!VALID_INDEX(plane_index, bsp->bsp3d.planes.count))
+		return -1.f;
+	plane = TAG_BLOCK_GET_ELEMENT(&bsp->bsp3d.planes, plane_index, real_plane3d);
+	up = plane->n.k;
+	return (surface->plane_designator & LONG_MIN) ? -up : up;
+}
+
+/* the surfaces across a surface's edges and the middles of those edges, as
+ai/path.c's build_path_edges_for_surface walks them (none: an open edge) */
+static short hud_port_guide_map_ring(
+	struct collision_bsp const *bsp,
+	long surface_index,
+	long *adjacents,
+	real_point3d *middles)
+{
+	struct collision_surface const *surface;
+	long edge_index;
+	short edge_count = 0;
+	short count = 0;
+
+	if (!VALID_INDEX(surface_index, bsp->surfaces.count))
+		return 0;
+	surface = TAG_BLOCK_GET_ELEMENT(&bsp->surfaces, surface_index, struct collision_surface);
+	edge_index = surface->first_edge_index;
+	do
+	{
+		struct collision_edge const *edge;
+		struct collision_vertex const *start;
+		struct collision_vertex const *end;
+		boolean right;
+
+		if (!collision_surface_edge_ring_continues(bsp, edge_index, edge_count))
+			break;
+		edge = TAG_BLOCK_GET_ELEMENT(&bsp->edges, edge_index, struct collision_edge);
+		if (!VALID_INDEX(edge->vertex_indices[0], bsp->vertices.count) ||
+			!VALID_INDEX(edge->vertex_indices[1], bsp->vertices.count))
+		{
+			break;
+		}
+		edge_count++;
+		right = surface_index==edge->surface_indices[1];
+		start = TAG_BLOCK_GET_ELEMENT(&bsp->vertices, edge->vertex_indices[0], struct collision_vertex);
+		end = TAG_BLOCK_GET_ELEMENT(&bsp->vertices, edge->vertex_indices[1], struct collision_vertex);
+		adjacents[count] = edge->surface_indices[!right];
+		middles[count].x = (start->point.x+end->point.x)*0.5f;
+		middles[count].y = (start->point.y+end->point.y)*0.5f;
+		middles[count].z = (start->point.z+end->point.z)*0.5f;
+		count++;
+		if (edge_count>=MAXIMUM_EDGES_PER_COLLISION_SURFACE)
+			break;
+		edge_index = edge->edge_indices[right];
+	}
+	while (edge_index!=surface->first_edge_index);
+
+	return count;
+}
+
+/* what the player can stand on: the AI's walkable surfaces, and slopes the
+player walks up (GUIDE_MAP_PLAYER_SLOPE, GUIDE_MAP_STEEP_SLOPE); 0 none, 1
+the AI's, 2 a slope, 3 a steep slope */
+static short hud_port_guide_map_floor_kind(
+	struct structure_bsp const *structure,
+	struct collision_bsp const *bsp,
+	long surface_index)
+{
+	byte const *pathfinding_surfaces = structure->pathfinding_surfaces.address;
+
+	if (!VALID_INDEX(surface_index, bsp->surfaces.count) ||
+		!VALID_INDEX(surface_index, structure->pathfinding_surfaces.count))
+	{
+		return 0;
+	}
+	if (TEST_FLAG(pathfinding_surfaces[surface_index], GUIDE_MAP_WALKABLE_BIT))
+		return 1;
+	{
+		real up = hud_port_guide_map_slope(bsp, surface_index);
+
+		return up>=GUIDE_MAP_PLAYER_SLOPE ? 2 : up>=GUIDE_MAP_STEEP_SLOPE ? 3 : 0;
+	}
+}
+
+/* the floors the player can come from to a surface (it walks from them onto
+it), the middles of the edges it crosses, and how far each is from the
+surface's anchor (its way on to the target): a floor next to it, or a floor
+past a low wall or slope of one surface, which the player jumps up (at most
+GUIDE_MAP_CLIMB) or drops down (at most GUIDE_MAP_DROP): a step, a ledge, a
+bank between two pieces of the terrain, which the AI never crosses */
+static short hud_port_guide_map_neighbors(
+	struct structure_bsp const *structure,
+	struct collision_bsp const *bsp,
+	long surface_index,
+	real_point3d const *anchor,
+	long *neighbors,
+	real_point3d *middles,
+	real *lengths)
+{
+	long adjacents[MAXIMUM_EDGES_PER_COLLISION_SURFACE];
+	real_point3d edge_middles[MAXIMUM_EDGES_PER_COLLISION_SURFACE];
+	short ring_count = hud_port_guide_map_ring(bsp, surface_index, adjacents, edge_middles);
+	short ring_index;
+	short count = 0;
+
+	for (ring_index = 0; ring_index<ring_count; ring_index++)
+	{
+		long adjacent = adjacents[ring_index];
+		short kind;
+		real up;
+
+		if (adjacent==NONE)
+		{
+			continue;
+		}
+		if (!VALID_INDEX(adjacent, bsp->surfaces.count) ||
+			!VALID_INDEX(adjacent, structure->pathfinding_surfaces.count))
+		{
+			continue;
+		}
+		kind = hud_port_guide_map_floor_kind(structure, bsp, adjacent);
+		if (kind!=0)
+		{
+			if (count<GUIDE_MAP_MAXIMUM_NEIGHBORS)
+			{
+				neighbors[count] = adjacent;
+				middles[count] = edge_middles[ring_index];
+				lengths[count] = distance3d(anchor, &edge_middles[ring_index])*
+					(kind==1 ? 1.f : kind==2 ? GUIDE_MAP_SLOPE_COST : GUIDE_MAP_STEEP_COST);
+				count++;
+			}
+			continue;
+		}
+		up = hud_port_guide_map_slope(bsp, adjacent);
+		if (up>-0.3f)
+		{
+			/* a wall or a steep slope: the floors past it, through a bank of at
+			most GUIDE_MAP_BANK_SURFACES of them, if it is low enough: each edge
+			on the way within the climb and the drop from this surface's side */
+			struct
+			{
+				long surface_index;
+				real_point3d entry;
+				real length;
+				short depth;
+			} bank[GUIDE_MAP_BANK_SEARCH];
+			long seen[GUIDE_MAP_BANK_SEARCH];
+			short bank_count = 0;
+			short seen_count = 0;
+			real side_height = edge_middles[ring_index].z;
+
+			bank[bank_count].surface_index = adjacent;
+			bank[bank_count].entry = edge_middles[ring_index];
+			bank[bank_count].length = distance3d(anchor, &edge_middles[ring_index]);
+			bank[bank_count].depth = 1;
+			bank_count++;
+			seen[seen_count++] = adjacent;
+			while (bank_count>0 && count<GUIDE_MAP_MAXIMUM_NEIGHBORS)
+			{
+				long far_adjacents[MAXIMUM_EDGES_PER_COLLISION_SURFACE];
+				real_point3d far_middles[MAXIMUM_EDGES_PER_COLLISION_SURFACE];
+				long wall_index = bank[--bank_count].surface_index;
+				real_point3d entry = bank[bank_count].entry;
+				real length = bank[bank_count].length;
+				short depth = bank[bank_count].depth;
+				short far_count = hud_port_guide_map_ring(bsp, wall_index, far_adjacents, far_middles);
+				short far_index;
+
+				for (far_index = 0; far_index<far_count && count<GUIDE_MAP_MAXIMUM_NEIGHBORS; far_index++)
+				{
+					long far_adjacent = far_adjacents[far_index];
+					/* (the player comes from the far side: up to this surface's) */
+					real climb = side_height-far_middles[far_index].z;
+					real far_length;
+					short seen_index;
+
+					if (far_adjacent==NONE || far_adjacent==surface_index ||
+						!VALID_INDEX(far_adjacent, bsp->surfaces.count) ||
+						climb>GUIDE_MAP_CLIMB || climb<-GUIDE_MAP_DROP)
+					{
+						continue;
+					}
+					for (seen_index = 0; seen_index<seen_count && seen[seen_index]!=far_adjacent; seen_index++)
+						;
+					if (seen_index<seen_count || seen_count>=GUIDE_MAP_BANK_SEARCH)
+						continue;
+					seen[seen_count++] = far_adjacent;
+					far_length = length+distance3d(&entry, &far_middles[far_index]);
+					if (hud_port_guide_map_floor_kind(structure, bsp, far_adjacent)!=0)
+					{
+						neighbors[count] = far_adjacent;
+						middles[count] = far_middles[far_index];
+						lengths[count] = far_length*GUIDE_MAP_STEP_COST;
+						count++;
+					}
+					else if (depth<GUIDE_MAP_BANK_SURFACES && bank_count<GUIDE_MAP_BANK_SEARCH &&
+						hud_port_guide_map_slope(bsp, far_adjacent)>-0.3f)
+					{
+						bank[bank_count].surface_index = far_adjacent;
+						bank[bank_count].entry = far_middles[far_index];
+						bank[bank_count].length = far_length;
+						bank[bank_count].depth = depth+1;
+						bank_count++;
+					}
+				}
+			}
+		}
+	}
+
+	return count;
+}
+
+static void hud_port_guide_map_sift_up(
+	long place)
+{
+	long *heap = hud_port_guide_map.heap;
+	real const *distances = hud_port_guide_map.distances;
+	long surface_index = heap[place];
+
+	while (place>0)
+	{
+		long parent = (place-1)/2;
+
+		if (distances[heap[parent]]<=distances[surface_index])
+			break;
+		heap[place] = heap[parent];
+		hud_port_guide_map.places[heap[place]] = place;
+		place = parent;
+	}
+	heap[place] = surface_index;
+	hud_port_guide_map.places[surface_index] = place;
+}
+
+static long hud_port_guide_map_pop(
+	void)
+{
+	long *heap = hud_port_guide_map.heap;
+	real const *distances = hud_port_guide_map.distances;
+	long top = heap[0];
+	long last = heap[--hud_port_guide_map.heap_count];
+	long count = hud_port_guide_map.heap_count;
+	long place = 0;
+
+	if (count>0)
+	{
+		for (;;)
+		{
+			long child = place*2+1;
+
+			if (child>=count)
+				break;
+			if (child+1<count && distances[heap[child+1]]<distances[heap[child]])
+				child++;
+			if (distances[heap[child]]>=distances[last])
+				break;
+			heap[place] = heap[child];
+			hud_port_guide_map.places[heap[place]] = place;
+			place = child;
+		}
+		heap[place] = last;
+		hud_port_guide_map.places[last] = place;
+	}
+	hud_port_guide_map.places[top] = GUIDE_MAP_DONE;
+
+	return top;
+}
+
+/* the map's room given back (the game's free takes no NULL: debug_memory.c) */
+static void hud_port_guide_map_free(
+	void)
+{
+	if (hud_port_guide_map.distances)
+		free(hud_port_guide_map.distances);
+	if (hud_port_guide_map.nexts)
+		free(hud_port_guide_map.nexts);
+	if (hud_port_guide_map.anchors)
+		free(hud_port_guide_map.anchors);
+	if (hud_port_guide_map.places)
+		free(hud_port_guide_map.places);
+	if (hud_port_guide_map.heap)
+		free(hud_port_guide_map.heap);
+	hud_port_guide_map.distances = NULL;
+	hud_port_guide_map.nexts = NULL;
+	hud_port_guide_map.anchors = NULL;
+	hud_port_guide_map.places = NULL;
+	hud_port_guide_map.heap = NULL;
+	hud_port_guide_map.capacity = 0;
+}
+
+/* a new map from a floor under the target; FALSE if there is no room for it */
+static boolean hud_port_guide_map_start(
+	real_point3d const *target,
+	long goal_surface_index,
+	real_point3d const *goal_point,
+	short candidate_index)
+{
+	struct structure_bsp const *structure;
+	struct collision_bsp const *bsp = hud_port_guide_map_bsp(&structure);
+	long count;
+	long index;
+
+	hud_port_guide_map.active = FALSE;
+	if (!bsp || !VALID_INDEX(goal_surface_index, bsp->surfaces.count))
+		return FALSE;
+	count = bsp->surfaces.count;
+	if (count>hud_port_guide_map.capacity)
+	{
+		/* (the room is taken once, as big as the level's part needs, and kept) */
+		hud_port_guide_map_free();
+		hud_port_guide_map.distances = malloc(count*sizeof(real));
+		hud_port_guide_map.nexts = malloc(count*sizeof(long));
+		hud_port_guide_map.anchors = malloc(count*sizeof(real_point3d));
+		hud_port_guide_map.places = malloc(count*sizeof(long));
+		hud_port_guide_map.heap = malloc(count*sizeof(long));
+		hud_port_guide_map.capacity = count;
+		if (!hud_port_guide_map.distances || !hud_port_guide_map.nexts || !hud_port_guide_map.anchors ||
+			!hud_port_guide_map.places || !hud_port_guide_map.heap)
+		{
+			hud_port_guide_map_free();
+			error(_error_log, "guide: no memory for the distance map (%ld surfaces)", count);
+			return FALSE;
+		}
+	}
+	for (index = 0; index<count; index++)
+	{
+		hud_port_guide_map.distances[index] = GUIDE_MAP_FAR;
+		hud_port_guide_map.places[index] = GUIDE_MAP_UNSEEN;
+	}
+	hud_port_guide_map.surface_count = count;
+	hud_port_guide_map.structure_bsp_index = global_structure_bsp_index_get();
+	hud_port_guide_map.goal_surface_index = goal_surface_index;
+	hud_port_guide_map.target = *hud_port_guide_map_key(target);
+	hud_port_guide_map.candidate_index = candidate_index;
+	hud_port_guide_map.distances[goal_surface_index] = 0.f;
+	hud_port_guide_map.nexts[goal_surface_index] = NONE;
+	hud_port_guide_map.anchors[goal_surface_index] = *goal_point;
+	hud_port_guide_map.heap[0] = goal_surface_index;
+	hud_port_guide_map.places[goal_surface_index] = 0;
+	hud_port_guide_map.heap_count = 1;
+	hud_port_guide_map.active = TRUE;
+	hud_port_guide_map.complete = FALSE;
+	hud_port_guide_map.last_tick = NONE;
+	hud_port_guide_map.reached_count = 0;
+	hud_port_guide_map.started_tick = game_time_get();
+	hud_port_guide_map.milliseconds = 0;
+
+	return TRUE;
+}
+
+/* the map's work for this tick: at most GUIDE_MAP_STEPS_PER_TICK surfaces */
+static void hud_port_guide_map_step(
+	void)
+{
+	struct structure_bsp const *structure;
+	struct collision_bsp const *bsp;
+	long time = game_time_get();
+	unsigned long started;
+	long step;
+
+	if (!hud_port_guide_map.active || hud_port_guide_map.complete || time==hud_port_guide_map.last_tick)
+		return;
+	hud_port_guide_map.last_tick = time;
+	bsp = hud_port_guide_map_bsp(&structure);
+	if (!bsp || hud_port_guide_map.structure_bsp_index!=global_structure_bsp_index_get() ||
+		bsp->surfaces.count!=hud_port_guide_map.surface_count)
+	{
+		hud_port_guide_map.active = FALSE;
+		return;
+	}
+	started = system_milliseconds();
+	for (step = 0; step<GUIDE_MAP_STEPS_PER_TICK && hud_port_guide_map.heap_count>0; step++)
+	{
+		/* (and no more than its time in a tick) */
+		if ((step & 63)==63 && system_milliseconds()-started>=GUIDE_MAP_TICK_MILLISECONDS)
+			break;
+		long neighbors[GUIDE_MAP_MAXIMUM_NEIGHBORS];
+		real_point3d middles[GUIDE_MAP_MAXIMUM_NEIGHBORS];
+		real lengths[GUIDE_MAP_MAXIMUM_NEIGHBORS];
+		long surface_index = hud_port_guide_map_pop();
+		real_point3d anchor = hud_port_guide_map.anchors[surface_index];
+		real distance = hud_port_guide_map.distances[surface_index];
+		short count = hud_port_guide_map_neighbors(structure, bsp, surface_index, &anchor, neighbors, middles,
+			lengths);
+		short index;
+
+		hud_port_guide_map.reached_count++;
+		for (index = 0; index<count; index++)
+		{
+			long neighbor = neighbors[index];
+			real cost;
+
+			if (hud_port_guide_map.places[neighbor]==GUIDE_MAP_DONE)
+				continue;
+			cost = distance+lengths[index];
+			if (cost<hud_port_guide_map.distances[neighbor])
+			{
+				hud_port_guide_map.distances[neighbor] = cost;
+				hud_port_guide_map.nexts[neighbor] = surface_index;
+				hud_port_guide_map.anchors[neighbor] = middles[index];
+				if (hud_port_guide_map.places[neighbor]==GUIDE_MAP_UNSEEN)
+				{
+					hud_port_guide_map.places[neighbor] = hud_port_guide_map.heap_count;
+					hud_port_guide_map.heap[hud_port_guide_map.heap_count++] = neighbor;
+				}
+				hud_port_guide_map_sift_up(hud_port_guide_map.places[neighbor]);
+			}
+		}
+	}
+	hud_port_guide_map.milliseconds += system_milliseconds()-started;
+	if (hud_port_guide_map.heap_count==0)
+	{
+		hud_port_guide_map.complete = TRUE;
+	}
+}
+
+/* whether the map is for this target (and for the part of the level loaded) */
+static boolean hud_port_guide_map_for(
+	real_point3d const *target)
+{
+	return hud_port_guide_map.active &&
+		hud_port_guide_map.structure_bsp_index==global_structure_bsp_index_get() &&
+		distance_squared3d(&hud_port_guide_map.target, hud_port_guide_map_key(target))<=
+			GUIDE_MAP_TARGET_MOVED*GUIDE_MAP_TARGET_MOVED;
+}
+
+/* whether the map is done and reaches a surface */
+static boolean hud_port_guide_map_reaches(
+	long surface_index)
+{
+	return hud_port_guide_map.active && hud_port_guide_map.complete &&
+		VALID_INDEX(surface_index, hud_port_guide_map.surface_count) &&
+		hud_port_guide_map.places[surface_index]==GUIDE_MAP_DONE;
+}
+
+/* from the player's floor, the walking distance to the target and the point
+some way toward it along the map (_guide_map_waypoint), or that the target is
+near (_guide_map_near), or _guide_map_none when the map cannot tell */
+static short hud_port_guide_map_waypoint(
+	long start_surface_index,
+	real_point3d const *start,
+	real_point3d *waypoint,
+	long *waypoint_surface_index,
+	real *walking_distance)
+{
+	real_point3d previous;
+	real travelled = 0.f;
+	long surface_index = start_surface_index;
+	long steps = 0;
+
+	if (!hud_port_guide_map_reaches(start_surface_index))
+		return _guide_map_none;
+	*walking_distance = hud_port_guide_map.distances[start_surface_index]+
+		distance3d(start, &hud_port_guide_map.anchors[start_surface_index]);
+	previous = *start;
+	while (hud_port_guide_map.nexts[surface_index]!=NONE && travelled<GUIDE_MAP_WAYPOINT_DISTANCE &&
+		steps<hud_port_guide_map.surface_count)
+	{
+		travelled += distance3d(&previous, &hud_port_guide_map.anchors[surface_index]);
+		previous = hud_port_guide_map.anchors[surface_index];
+		surface_index = hud_port_guide_map.nexts[surface_index];
+		steps++;
+	}
+	if (hud_port_guide_map.nexts[surface_index]==NONE)
+		return _guide_map_near;
+	/* (inside the surface: between where the way comes into it and where it
+	leaves it) */
+	waypoint->x = (previous.x+hud_port_guide_map.anchors[surface_index].x)*0.5f;
+	waypoint->y = (previous.y+hud_port_guide_map.anchors[surface_index].y)*0.5f;
+	waypoint->z = (previous.z+hud_port_guide_map.anchors[surface_index].z)*0.5f;
+	*waypoint_surface_index = surface_index;
+
+	return _guide_map_waypoint;
+}
+
+/* the walking distance from where the player is now (a biped on foot knows its
+floor without a ray), for the meters shown every frame */
+static boolean hud_port_guide_map_walking(
+	long unit_index,
+	real_point3d const *target,
+	real *walking_distance)
+{
+	struct biped_datum *biped = biped_try_and_get(unit_index);
+	long surface_index;
+	real_point3d origin;
+
+	if (!hud_port_guide_map_for(target) || !biped || biped->object.parent_object_index!=NONE)
+		return FALSE;
+	surface_index = biped->biped.pathfinding_surface_index;
+	if (!hud_port_guide_map_reaches(surface_index))
+		return FALSE;
+	object_get_origin(unit_index, &origin);
+	*walking_distance = hud_port_guide_map.distances[surface_index]+
+		distance3d(&origin, &hud_port_guide_map.anchors[surface_index]);
+	return TRUE;
+}
+
+static boolean hud_port_guide_route_find(
+	long unit_index,
+	real_point3d const *target,
+	long target_object_index,
+	struct hud_port_guide_route_datum *route)
+{
+	struct path_input input;
+	struct path_result path;
+	real_point3d start = { 0 }, goal = { 0 };
+	long start_surface_index = NONE;
+	long goal_surface_index = NONE;
+	struct biped_datum *biped = biped_try_and_get(unit_index);
+	boolean found = FALSE;
+	/* the distance map's waypoint, when the route goes to it */
+	real_point3d map_waypoint = { 0 };
+	boolean map_waypoint_valid = FALSE;
+
+	route->step_count = 0;
+	route->status = 'S';
+	/* the player's floor: a biped on foot keeps it (biped_find_pathfinding_surface_index,
+	what the AI walks its own bipeds from; only read here, the hud does not change the
+	game); in a seat or when it is not known yet, the floor under the player */
+	if (biped && biped->object.parent_object_index==NONE &&
+		biped->biped.pathfinding_surface_index!=NONE)
+	{
+		start = biped->biped.pathfinding_point;
+		start_surface_index = biped->biped.pathfinding_surface_index;
+	}
+	if (start_surface_index==NONE)
+	{
+		real_point3d origin;
+
+		object_get_origin(unit_index, &origin);
+		if (!hud_port_guide_floor(&origin, 3.f, &start, &start_surface_index))
+		{
+			start = origin;
+			goto listo;
+		}
+	}
+	if (!hud_port_guide_goal_floor(target, 0, &goal, &goal_surface_index))
+	{
+		route->status = 'T';
+		goal = *target;
+		goto listo;
+	}
+	route->status = 'P';
+
+	path_input_new(&input, 0.2f, FALSE, biped && biped->object.parent_object_index!=NONE ?
+		biped->object.parent_object_index : unit_index);
+	path_input_set_start(&input, &start, start_surface_index);
+	if (target_object_index!=NONE)
+	{
+		input.ignore_target_object_index = target_object_index;
+	}
+
+	/* the distance map: a new one when the target moved or the level's part
+	changed; one done that does not reach the player is tried again from the
+	target's next floor (the first can be a roof) */
+	if (!hud_port_guide_map_for(target))
+	{
+		hud_port_guide_map_start(target, goal_surface_index, &goal, 0);
+	}
+	else if (hud_port_guide_map.complete && !hud_port_guide_map_reaches(start_surface_index) &&
+		hud_port_guide_map.candidate_index+1<GUIDE_MAP_MAXIMUM_CANDIDATES &&
+		hud_port_guide_map.reached_count<GUIDE_MAP_ISLAND_SURFACES &&
+		hud_port_guide_map.reached_count<hud_port_guide_map.surface_count/10)
+	{
+		real_point3d next_goal;
+		long next_goal_surface_index;
+		short candidate_index = hud_port_guide_map.candidate_index+1;
+
+		if (hud_port_guide_goal_floor(target, candidate_index, &next_goal, &next_goal_surface_index))
+			hud_port_guide_map_start(target, next_goal_surface_index, &next_goal, candidate_index);
+		else
+			hud_port_guide_map.candidate_index = GUIDE_MAP_MAXIMUM_CANDIDATES;
+	}
+	{
+		real_point3d waypoint;
+		long waypoint_surface_index;
+		real walking_distance;
+		short map_result = hud_port_guide_map_waypoint(start_surface_index, &start, &waypoint,
+			&waypoint_surface_index, &walking_distance);
+
+		if (map_result==_guide_map_waypoint)
+		{
+			/* the short way to the map's waypoint, which the search always
+			covers; the part of it that comes closest when something is in the
+			way */
+			route->status = 'M';
+			map_waypoint = waypoint;
+			map_waypoint_valid = TRUE;
+			path_state_new(&input, &hud_port_guide_path_state, NULL);
+			path_state_destination(&hud_port_guide_path_state, &waypoint, waypoint_surface_index, 0.5f);
+			if (!path_state_find(&hud_port_guide_path_state))
+			{
+				/* (a slope the AI does not walk, between: straight at the waypoint,
+				which the map knows is the way) */
+				route->status = 'N';
+				route->steps[0] = waypoint;
+				route->step_count = 1;
+				found = TRUE;
+				goto listo;
+			}
+			goto construir;
+		}
+	}
+	route->status = 'P';
+	/* the target's floors one after another until one can be walked to (a floor
+	found from higher up can be a roof); with none, part of the way to the first */
+	{
+		short candidate_index;
+		boolean reached = FALSE;
+		real_point3d first_goal = goal;
+		long first_goal_surface_index = goal_surface_index;
+
+		for (candidate_index = 0; candidate_index<GUIDE_ROUTE_MAXIMUM_FLOORS && !reached; candidate_index++)
+		{
+			if (candidate_index>0 &&
+				!hud_port_guide_goal_floor(target, candidate_index, &goal, &goal_surface_index))
+			{
+				break;
+			}
+			path_state_new(&input, &hud_port_guide_path_state, NULL);
+			path_state_destination(&hud_port_guide_path_state, &goal, goal_surface_index, 0.3f);
+			reached = path_state_find(&hud_port_guide_path_state);
+		}
+		if (!reached)
+		{
+			if (candidate_index>1)
+			{
+				goal = first_goal;
+				goal_surface_index = first_goal_surface_index;
+				path_state_new(&input, &hud_port_guide_path_state, NULL);
+				path_state_destination(&hud_port_guide_path_state, &goal, goal_surface_index, 0.3f);
+				path_state_find(&hud_port_guide_path_state);
+			}
+			if (hud_port_guide_path_state.closest_node_index!=NONE)
+			{
+				/* not all the way (the search ran out, or no way): the part of the
+				way that comes closest to the target */
+				hud_port_guide_path_state.destination.target_radius = 10000.f;
+				route->status = 'C';
+			}
+			else
+			{
+				route->status = 'F';
+			}
+		}
+	}
+construir:
+	if (path_state_build_path(&hud_port_guide_path_state, &path) && path.valid && path.step_count>0)
+	{
+		short step_index;
+
+		for (step_index = path.step_index; step_index<path.step_count && route->step_count<GUIDE_ROUTE_MAXIMUM_STEPS; step_index++)
+		{
+			route->steps[route->step_count++] = path.steps[step_index].point;
+		}
+		found = route->step_count>0;
+	}
+	if (!found && map_waypoint_valid)
+	{
+		/* (the search reached it with no corner on the way, a straight line on
+		one floor: the waypoint itself) */
+		route->steps[0] = map_waypoint;
+		route->step_count = 1;
+		found = TRUE;
+	}
+	if (!found && route->status!='F')
+	{
+		route->status = route->status=='C' || route->status=='N' ? 'X' : 'B';
+	}
+
+listo:
+	return found;
+}
+
+/* where the arrow is drawn: the next corner of the route the player has not
+reached, or the target */
+static void hud_port_guide_route_point(
+	short local_player_index,
+	long unit_index,
+	real_point3d const *target,
+	long target_object_index,
+	real_point3d *point)
+{
+	struct hud_port_guide_route_datum *route = &hud_port_guide_routes[local_player_index & 3];
+	long time = game_time_get();
+	short bsp_index = global_structure_bsp_index_get();
+	struct biped_datum *biped = biped_try_and_get(unit_index);
+	/* (in a vehicle the corners come faster and are passed wider) */
+	boolean riding = biped && biped->object.parent_object_index!=NONE;
+	long refresh_ticks = riding ? GUIDE_ROUTE_REFRESH_TICKS/2 : GUIDE_ROUTE_REFRESH_TICKS;
+	real reached = riding ? GUIDE_ROUTE_CORNER_REACHED_RIDING : GUIDE_ROUTE_CORNER_REACHED;
+	real_point3d origin;
+	short step_index;
+
+	*point = *target;
+	object_get_origin(unit_index, &origin);
+	if (!route->valid || time<route->time || time-route->time>=refresh_ticks ||
+		route->structure_bsp_index!=bsp_index ||
+		(time-route->time>=GUIDE_ROUTE_MINIMUM_TICKS &&
+			distance_squared3d(&route->target, target)>GUIDE_ROUTE_TARGET_MOVED*GUIDE_ROUTE_TARGET_MOVED))
+	{
+		route->valid = TRUE;
+		route->time = time;
+		route->structure_bsp_index = bsp_index;
+		route->target = *target;
+		if (!hud_port_guide_route_find(unit_index, target, target_object_index, route))
+		{
+			route->step_count = 0;
+		}
+	}
+
+	for (step_index = 0; step_index<route->step_count; step_index++)
+	{
+		real_point3d const *step = &route->steps[step_index];
+		real dx = step->x-origin.x;
+		real dy = step->y-origin.y;
+		boolean passed = dx*dx+dy*dy<=reached*reached;
+
+		/* a corner is passed, too, once the player is nearer the next one than
+		it is (a wide turn goes by it) */
+		if (!passed && step_index+1<route->step_count)
+		{
+			real_point3d const *next = &route->steps[step_index+1];
+			real player_x = next->x-origin.x, player_y = next->y-origin.y;
+			real corner_x = next->x-step->x, corner_y = next->y-step->y;
+
+			passed = player_x*player_x+player_y*player_y<corner_x*corner_x+corner_y*corner_y;
+		}
+		if (!passed)
+		{
+			/* the last corner is the target's floor: the target itself */
+			if (step_index<route->step_count-1 ||
+				distance_squared3d(step, target)>1.f)
+			{
+				*point = *step;
+				point->z += GUIDE_ROUTE_ARROW_HEIGHT;
+			}
+			break;
+		}
+	}
+
+	return;
+}
+
+/* port: the guide arrow's lines (custom_render_nav_point draws them under it):
+SUBE or BAJA when the target is on another floor near enough, how many of the
+step's enemies are left, a weapon for empty ones; and what to do at the step,
+for the corner (hud_port_guide_draw_objective). What to do is not always there:
+a while when it changes or the arrow comes back (after a cutscene, a load, the
+pause), then a little every few minutes */
+#define GUIDE_FLOOR_HEIGHT 1.2f /* (world units: a floor is about 3 meters) */
+#define GUIDE_TEXT_FIRST_MILLISECONDS 8000 /* (when it changes or comes back) */
+#define GUIDE_TEXT_AGAIN_MILLISECONDS 120000 /* (then every this long, ...) */
+#define GUIDE_TEXT_AGAIN_SHOWN_MILLISECONDS 6000 /* (... this long) */
+#define GUIDE_TEXT_BACK_MILLISECONDS 5000 /* (the arrow away this long: it comes back) */
+
+static void hud_port_guide_lines(
+	short local_player_index,
+	long unit_index,
+	real_point3d const *target,
+	wchar_t *label,
+	short label_size,
+	wchar_t *objective,
+	short objective_size)
+{
+	static char const *shown_text = NULL;
+	static unsigned long shown_since = 0, last_drawn = 0;
+	unsigned long now = system_milliseconds();
+	real_point3d origin, player_floor, goal_floor;
+	long surface_index;
+	real dz, horizontal;
+	short length = 0;
+
+	object_get_origin(unit_index, &origin);
+	if (hud_port_guide_floor(&origin, 3.f, &player_floor, &surface_index) &&
+		hud_port_guide_goal_floor(target, 0, &goal_floor, &surface_index))
+	{
+		dz = goal_floor.z-player_floor.z;
+	}
+	else
+	{
+		dz = target->z-origin.z;
+	}
+	horizontal = square_root((target->x-origin.x)*(target->x-origin.x)+(target->y-origin.y)*(target->y-origin.y));
+
+	label[0] = 0;
+	objective[0] = 0;
+#define GUIDE_LINE(...) \
+	if (length<label_size-1) \
+	{ \
+		if (length>0 && length<label_size-3) { label[length++] = '\r'; label[length++] = '\n'; } \
+		usnprintf(label+length, label_size-1-length, __VA_ARGS__); \
+		label[label_size-1] = 0; \
+		length = (short)ustrlen(label); \
+	}
+	if (fabs(dz)>=GUIDE_FLOOR_HEIGHT && fabs(dz)>=0.25f*horizontal)
+	{
+		GUIDE_LINE(dz>0.f ? L"SUBE" : L"BAJA");
+	}
+	if (hud_port_guide_kind==_hud_port_guide_step_enemy)
+	{
+		GUIDE_LINE(L"QUEDAN %d", (int)hud_port_guide_remaining);
+	}
+	else if (hud_port_guide_kind==_hud_port_guide_weapon)
+	{
+		GUIDE_LINE(L"SIN BALAS: TOMA ESTA ARMA");
+	}
+	if (hud_port_guide_text &&
+		(hud_port_guide_kind==_hud_port_guide_place || hud_port_guide_kind==_hud_port_guide_step_enemy))
+	{
+		wchar_t text[64];
+		short index;
+
+		for (index = 0; index<NUMBEROF(text)-1 && hud_port_guide_text[index]; index++)
+			text[index] = (wchar_t)(unsigned char)hud_port_guide_text[index];
+		text[index] = 0;
+		/* (a while when it changes or the arrow comes back, then a little now and then) */
+		if (hud_port_guide_text!=shown_text || !last_drawn || now-last_drawn>=GUIDE_TEXT_BACK_MILLISECONDS)
+		{
+			shown_text = hud_port_guide_text;
+			shown_since = now;
+		}
+		if (now-shown_since<GUIDE_TEXT_FIRST_MILLISECONDS ||
+			(now-shown_since)%GUIDE_TEXT_AGAIN_MILLISECONDS<GUIDE_TEXT_AGAIN_SHOWN_MILLISECONDS)
+		{
+			ustrncpy(objective, text, objective_size-1);
+			objective[objective_size-1] = 0;
+		}
+	}
+	last_drawn = now;
+#undef GUIDE_LINE
+
+	return;
+}
+
+/* port: what to do at the step, in the left corner under the HUD's messages:
+OBJETIVO and the text, with a shadow */
+static void hud_port_guide_draw_objective(
+	short local_player_index,
+	wchar_t const *objective)
+{
+	static wchar_t const heading[] = L"OBJETIVO";
+	long font_index = hud_get_font_index();
+	struct font_header *font;
+	short line_height, width;
+	point2d messages;
+	rectangle2d bounds;
+	real_argb_color heading_color, text_color, shadow_color;
+
+	if (!objective[0] || !hud_globals || font_index==NONE)
+		return;
+
+	font = font_definition_get(font_index);
+	line_height = font->leading_height + font->ascending_height + font->descending_height;
+	width = (short)((render.camera.viewport_bounds.x1 - render.camera.viewport_bounds.x0) * 0.4f);
+	/* (where the HUD's messages start, three lines under it: room for them) */
+	hud_calculate_point(local_player_index, &hud_globals->messaging.absolute_placement,
+		&hud_globals->messaging.placement, NULL, local_player_count()>1, 0.f, &messages);
+
+	heading_color.alpha = text_color.alpha = shadow_color.alpha = 1.f;
+	pixel32_to_real_rgb_color(HUD_PORT_GUIDE_COLOR, &heading_color.rgb);
+	text_color.rgb.red = text_color.rgb.green = text_color.rgb.blue = 0.92f;
+	shadow_color.rgb.red = shadow_color.rgb.green = shadow_color.rgb.blue = 0.f;
+
+	bounds.x0 = messages.x;
+	bounds.x1 = messages.x + width;
+	bounds.y0 = messages.y + 3 * line_height;
+	bounds.y1 = bounds.y0 + line_height;
+	/* (the shadow one point down and right, then the text) */
+	bounds.x0++; bounds.x1++; bounds.y0++; bounds.y1++;
+	draw_string_set_draw_mode(font_index, NONE, 0, 0, &shadow_color); /* (0: left) */
+	rasterizer_draw_unicode_string(&bounds, NULL, NULL, 0, heading);
+	bounds.x0--; bounds.x1--; bounds.y0--; bounds.y1--;
+	draw_string_set_draw_mode(font_index, NONE, 0, 0, &heading_color);
+	rasterizer_draw_unicode_string(&bounds, NULL, NULL, 0, heading);
+
+	bounds.y0 += line_height;
+	bounds.y1 = bounds.y0 + 2 * line_height;
+	bounds.x0++; bounds.x1++; bounds.y0++; bounds.y1++;
+	draw_string_set_draw_mode(font_index, NONE, 0, 0, &shadow_color);
+	rasterizer_draw_unicode_string(&bounds, NULL, NULL, 0, objective);
+	bounds.x0--; bounds.x1--; bounds.y0--; bounds.y1--;
+	draw_string_set_draw_mode(font_index, NONE, 0, 0, &text_color);
+	rasterizer_draw_unicode_string(&bounds, NULL, NULL, 0, objective);
+
+	return;
+}
+
+/* port: when the arrow was last drawn somewhere to go (the teleport button,
+below) */
+static unsigned long hud_port_guide_drawn_at = 0;
+static boolean hud_port_guide_target_reachable(real_point3d const *target);
+
+static void hud_port_guide_render(
+	short local_player_index)
+{
+	long player_index = local_player_get_player_index(local_player_index);
+	long unit_index = player_index==NONE ? NONE : player_get(player_index)->unit_index;
+	real_point3d target;
+	long target_object_index;
+
+	if (unit_index!=NONE && hud_globals->waypoint.arrows.count>0 &&
+		hud_port_guide_target(unit_index, &target, &target_object_index))
+	{
+		real_point3d head_position;
+		real_point3d camera_position;
+		real_point3d point;
+		long point_object_index;
+		wchar_t label[160];
+		wchar_t objective[64];
+
+		unit_get_head_position(unit_index, &head_position);
+		hud_port_guide_route_point(local_player_index, unit_index, &target, target_object_index, &point);
+		/* (the round radar's red diamond points the same way) */
+		{
+			real_point3d origin;
+			real dx, dy;
+
+			object_get_origin(unit_index, &origin);
+			dx = point.x-origin.x;
+			dy = point.y-origin.y;
+			if (dx*dx+dy*dy>0.25f)
+			{
+				hud_port_radar_objective(
+					local_player_index,
+					(real)atan2(dy, dx)-player_control_get_facing_angles(local_player_index)->yaw);
+			}
+		}
+		/* (the distance map's work for this tick, while it is not done) */
+		hud_port_guide_map_step();
+		point_object_index = point.x==target.x && point.y==target.y && point.z==target.z ?
+			target_object_index : NONE;
+		unit_get_camera_position(unit_index, &camera_position);
+		/* the meters: walking, from the distance map, when it knows them and the
+		target is not right there; else in a straight line */
+		hud_port_nav_distance_override = distance3d(&camera_position, &target);
+		if (hud_port_guide_map_walking(unit_index, &target, &hud_port_guide_walking_distance) &&
+			hud_port_guide_walking_distance>hud_port_nav_distance_override)
+		{
+			hud_port_nav_distance_override = hud_port_guide_walking_distance;
+		}
+		/* a corner of the route is drawn as in sight (the bumps of the ground hide
+		it): the hidden kind is left to the target itself, when there is no way */
+		/* (red for enemies, green for a weapon) */
+		hud_port_nav_color_override =
+			hud_port_guide_kind==_hud_port_guide_step_enemy || hud_port_guide_kind==_hud_port_guide_enemy ? 0x00FF4030 :
+			hud_port_guide_kind==_hud_port_guide_weapon ? 0x0040FF60 :
+			HUD_PORT_GUIDE_COLOR;
+		hud_port_guide_lines(local_player_index, unit_index, &target, label, NUMBEROF(label),
+			objective, NUMBEROF(objective));
+		hud_port_nav_label = label;
+		custom_render_nav_point(
+			local_player_index,
+			&point,
+			0,
+			point_object_index==target_object_index &&
+				point.x==target.x && point.y==target.y && point.z==target.z ?
+				hud_get_nav_point_render_type(local_player_index, &head_position, &point, point_object_index) :
+				0);
+		hud_port_nav_distance_override = -1.f;
+		hud_port_nav_color_override = 0;
+		hud_port_nav_label = NULL;
+		hud_port_guide_draw_objective(local_player_index, objective);
+		/* (the Ir button only for a target in the part of the level that is
+		loaded: one in another part, or outside the level, cannot be gone to) */
+		if (hud_port_guide_target_reachable(&target))
+			hud_port_guide_drawn_at = system_milliseconds();
+	}
+
+	return;
+}
