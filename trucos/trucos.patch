+    // ---------- the HUD's parts, moved in the editor (port/linux/src/touch_input.c)
+
+    private static boolean isHudPart(int target) {
+        return target <= HUD_PART && target > HUD_PART - HUD_PARTS;
+    }
+
+    /** where the game drew them: read while the editor is open */
+    private void readHud() {
+        if (!editing)
+            return;
+        int serial = nativeHudRects(hudRectsRead);
+        if (serial == 0 || serial == hudSerial)
+            return;
+        hudSerial = serial;
+        if (!Arrays.equals(hudRectsRead, hudRects)) {
+            System.arraycopy(hudRectsRead, 0, hudRects, 0, hudRects.length);
+            invalidate();
+        }
+    }
+
+    private boolean hudKnown(int part) {
+        return hudRects[part * 4] >= -0.5f && hudRects[part * 4 + 2] > hudRects[part * 4];
+    }
+
+    /** a part's box in logical units, where the editor has it: at least HUD_MINIMUM_BOX */
+    private float hudWidth(int part) {
+        return Math.max(HUD_MINIMUM_BOX, (hudRects[part * 4 + 2] - hudRects[part * 4]) * logicalWidth);
+    }
+
+    private float hudHeight(int part) {
+        return Math.max(HUD_MINIMUM_BOX, (hudRects[part * 4 + 3] - hudRects[part * 4 + 1]) * logicalHeight);
+    }
+
+    private float hudLeft(int part) {
+        float drawn = (hudRects[part * 4] + hudRects[part * 4 + 2]) / 2 * logicalWidth;
+        return drawn + hudMoves[part * 2] * logicalWidth - hudWidth(part) / 2;
+    }
+
+    private float hudTop(int part) {
+        float drawn = (hudRects[part * 4 + 1] + hudRects[part * 4 + 3]) / 2 * logicalHeight;
+        return drawn + hudMoves[part * 2 + 1] * logicalHeight - hudHeight(part) / 2;
+    }
+
+    /** the part under a point (logical units), the smallest first (the radar holds no other) */
+    private int hitHud(float x, float y) {
+        layoutHudTabs();
+        for (int part = 0; part < HUD_PARTS; part++) {
+            if (!Float.isNaN(hudTabs[part * 4]) && x >= hudTabs[part * 4] && x <= hudTabs[part * 4 + 2]
+                    && y >= hudTabs[part * 4 + 1] && y <= hudTabs[part * 4 + 3])
+                return HUD_PART - part;
+        }
+        int found = NOTHING;
+        float area = Float.MAX_VALUE;
+        for (int part = 0; part < HUD_PARTS; part++) {
+            if (!hudKnown(part))
+                continue;
+            float left = hudLeft(part);
+            float top = hudTop(part);
+            float width = hudWidth(part);
+            float height = hudHeight(part);
+            if (x >= left && x <= left + width && y >= top && y <= top + height && width * height < area) {
+                found = HUD_PART - part;
+                area = width * height;
+            }
+        }
+        return found;
+    }
+
+    /** where each part's tab goes: under its box (over it at the bottom of the screen), clear of the others */
+    private void layoutHudTabs() {
+        paint.setTextSize(13);
+        for (int part = 0; part < HUD_PARTS; part++) {
+            int at = part * 4;
+            if (!hudKnown(part)) {
+                hudTabs[at] = Float.NaN;
+                continue;
+            }
+            float left = hudLeft(part);
+            float top = hudTop(part);
+            float width = hudWidth(part);
+            float height = hudHeight(part);
+            float tabWidth = Math.max(70, paint.measureText(HUD_NAMES[part]) + 28);
+            float tabTop = top + height + HUD_TAB_GAP;
+            if (tabTop + HUD_TAB_HEIGHT > logicalHeight)
+                tabTop = top - HUD_TAB_GAP - HUD_TAB_HEIGHT;
+            tabTop = Math.max(0, Math.min(logicalHeight - HUD_TAB_HEIGHT, tabTop));
+            float tabLeft = Math.max(0, Math.min(logicalWidth - tabWidth, left + width / 2 - tabWidth / 2));
+            // (shield and health are drawn together: their tabs go side by side)
+            for (int tries = 0; tries < HUD_PARTS * 2; tries++) {
+                boolean clear = true;
+                for (int other = 0; other < part; other++) {
+                    int o = other * 4;
+                    if (Float.isNaN(hudTabs[o]) || tabLeft >= hudTabs[o + 2] + 4 || tabLeft + tabWidth + 4 <= hudTabs[o]
+                            || tabTop >= hudTabs[o + 3] || tabTop + HUD_TAB_HEIGHT <= hudTabs[o + 1])
+                        continue;
+                    clear = false;
+                    tabLeft = hudTabs[o + 2] + 4;
+                    if (tabLeft + tabWidth > logicalWidth)
+                        tabLeft = Math.max(0, hudTabs[o] - 4 - tabWidth);
+                }
+                if (clear)
+                    break;
+            }
+            hudTabs[at] = tabLeft;
+            hudTabs[at + 1] = tabTop;
+            hudTabs[at + 2] = tabLeft + tabWidth;
+            hudTabs[at + 3] = tabTop + HUD_TAB_HEIGHT;
+        }
+    }
+
+    /** a part dragged so that its box's corner is at a point; a box bigger than its picture
+     * (the radar's) may go past an edge, as long as some of it stays on the screen */
+    private void moveHud(int part, float left, float top) {
+        float width = hudWidth(part);
+        float height = hudHeight(part);
+        left = Math.max(HUD_KEEP_VISIBLE - width, Math.min(logicalWidth - HUD_KEEP_VISIBLE, left));
+        top = Math.max(HUD_KEEP_VISIBLE - height, Math.min(logicalHeight - HUD_KEEP_VISIBLE, top));
+        float drawnX = (hudRects[part * 4] + hudRects[part * 4 + 2]) / 2 * logicalWidth;
+        float drawnY = (hudRects[part * 4 + 1] + hudRects[part * 4 + 3]) / 2 * logicalHeight;
+        hudMoves[part * 2] = (left + width / 2 - drawnX) / logicalWidth;
+        hudMoves[part * 2 + 1] = (top + height / 2 - drawnY) / logicalHeight;
+        // (the game draws the part under the finger at once, to place it by eye)
+        nativeHudPreview(hudMoves);
+    }
+
+    /** Save: the game writes the moves to the HUD settings (TRUCOS, HUD) */
+    private void saveHud() {
+        boolean moved = false;
+        for (float move : hudMoves)
+            moved |= move != 0;
+        if (moved)
+            nativeHudMove(hudMoves);
+        Arrays.fill(hudMoves, 0);
+    }
+
+    private void drawHud(Canvas canvas) {
+        layoutHudTabs();
+        for (int part = 0; part < HUD_PARTS; part++) {
+            if (!hudKnown(part))
+                continue;
+            float left = hudLeft(part);
+            float top = hudTop(part);
+            float right = left + hudWidth(part);
+            float bottom = top + hudHeight(part);
+            boolean dragged = dragControl == HUD_PART - part;
+            // (nearly clear: the part itself shows inside, where the game draws it)
+            paint.setStyle(Paint.Style.FILL);
+            paint.setColor(dragged ? 0x2283d9ff : 0x1183d9ff);
+            canvas.drawRoundRect(left, top, right, bottom, 8, 8, paint);
+            paint.setStyle(Paint.Style.STROKE);
+            paint.setStrokeWidth(2);
+            paint.setColor(dragged ? 0xffaee7ff : 0xcc83d9ff);
+            canvas.drawRoundRect(left, top, right, bottom, 8, 8, paint);
+            // (its tab, with its name, joined to the box by a line)
+            int at = part * 4;
+            float tabLeft = hudTabs[at];
+            float tabTop = hudTabs[at + 1];
+            float tabRight = hudTabs[at + 2];
+            float tabBottom = hudTabs[at + 3];
+            float tabX = (tabLeft + tabRight) / 2;
+            float lineX = Math.max(left, Math.min(right, tabX));
+            boolean below = tabTop >= bottom;
+            canvas.drawLine(lineX, below ? bottom : top, tabX, below ? tabTop : tabBottom, paint);
+            paint.setStyle(Paint.Style.FILL);
+            paint.setColor(dragged ? 0xee83d9ff : 0xbb2a6a90);
+            canvas.drawRoundRect(tabLeft, tabTop, tabRight, tabBottom, 10, 10, paint);
+            paint.setStyle(Paint.Style.STROKE);
+            paint.setColor(dragged ? 0xffffffff : 0xcc83d9ff);
+            canvas.drawRoundRect(tabLeft, tabTop, tabRight, tabBottom, 10, 10, paint);
+            paint.setStyle(Paint.Style.FILL);
+            paint.setColor(Color.WHITE);
+            paint.setTextAlign(Paint.Align.CENTER);
+            paint.setTextSize(13);
+            canvas.drawText(HUD_NAMES[part], tabX, (tabTop + tabBottom) / 2 + 4.5f, paint);
+        }
+    }
