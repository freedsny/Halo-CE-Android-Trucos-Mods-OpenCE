+/* port: where the player has moved the parts of the HUD (settings, TRUCOS, HUD):
+hud.<part>_x and hud.<part>_y plus the fine ones, hud.<part>_fx and hud.<part>_fy, in HUD
+units, read again when a setting changes.
+They move the part whatever corner it is anchored to: positive x is right and
+positive y is down */
+long config_integer(const char *name);
+unsigned long config_changes(void);
+
+short hud_port_part = _hud_port_part_none;
+/* the editor's move of each part while a finger drags it, in HUD units, shown
+before it is saved (hud_port_offset adds it; the rectangles leave it out) */
+static real hud_port_preview[NUMBER_OF_HUD_PORT_PARTS][2];
+
+static real hud_port_offset(
+	short part,
+	short axis)
+{
+	static char const *const names[NUMBER_OF_HUD_PORT_PARTS][4] =
+	{
+		{ NULL, NULL, NULL, NULL },
+		{ "hud.shield_x", "hud.shield_y", "hud.shield_fx", "hud.shield_fy" },
+		{ "hud.health_x", "hud.health_y", "hud.health_fx", "hud.health_fy" },
+		{ "hud.radar_x", "hud.radar_y", "hud.radar_fx", "hud.radar_fy" },
+		{ "hud.ammo_x", "hud.ammo_y", "hud.ammo_fx", "hud.ammo_fy" },
+		{ "hud.grenades_x", "hud.grenades_y", "hud.grenades_fx", "hud.grenades_fy" },
+	};
+	static real offsets[NUMBER_OF_HUD_PORT_PARTS][2];
+	static unsigned long changes = 0;
+	static boolean read = FALSE;
+	real result = 0.0f;
+
+	if (part>0 && part<NUMBER_OF_HUD_PORT_PARTS && axis>=0 && axis<2)
+	{
+		if (!read || changes!=config_changes())
+		{
+			short part_index, axis_index;
+
+			read = TRUE;
+			changes = config_changes();
+			for (part_index = 1; part_index<NUMBER_OF_HUD_PORT_PARTS; part_index++)
+			{
+				for (axis_index = 0; axis_index<2; axis_index++)
+				{
+					long value = config_integer(names[part_index][axis_index])+
+						config_integer(names[part_index][axis_index+2]);
+
+					offsets[part_index][axis_index] = (real)PIN(value, -2000, 2000);
+				}
+			}
+		}
+		result = offsets[part][axis]+hud_port_preview[part][axis];
+	}
+
+	return result;
+}
+
+/* port: where each movable part was drawn, for the touch controls' editor,
+which moves them with a finger (port/linux/src/touch_input.c): the bounds of
+this frame's pictures of each part in the view's pixels, and the last frame's
+as fractions of the view, kept while a part is not drawn. Only with one local
+player; a picture as big as half the view (a scope's mask) is left out */
+static real hud_port_frame_bounds[NUMBER_OF_HUD_PORT_PARTS][4];
+static boolean hud_port_frame_drawn[NUMBER_OF_HUD_PORT_PARTS];
+static float hud_port_rects[NUMBER_OF_HUD_PORT_PARTS][4];
+static boolean hud_port_rects_known[NUMBER_OF_HUD_PORT_PARTS];
+static float hud_port_view_units[2];
+
+static void hud_port_note_quad(
+	struct dynamic_screen_vertex const *vertices)
+{
+	real width = (real)(render.camera.viewport_bounds.x1 - render.camera.viewport_bounds.x0);
+	real height = (real)(render.camera.viewport_bounds.y1 - render.camera.viewport_bounds.y0);
+	real x0 = vertices[0].position.x, x1 = x0, y0 = vertices[0].position.y, y1 = y0;
+	real *bounds;
+	short vertex_index;
+
+	if (hud_port_part<=_hud_port_part_none || hud_port_part>=NUMBER_OF_HUD_PORT_PARTS ||
+		local_player_count()!=1 || width<=0.0f || height<=0.0f)
+	{
+		return;
+	}
+	for (vertex_index = 1; vertex_index<4; vertex_index++)
+	{
+		x0 = MIN(x0, vertices[vertex_index].position.x);
+		x1 = MAX(x1, vertices[vertex_index].position.x);
+		y0 = MIN(y0, vertices[vertex_index].position.y);
+		y1 = MAX(y1, vertices[vertex_index].position.y);
+	}
+	if (x1-x0>width*0.5f || y1-y0>height*0.5f || x1<=x0 || y1<=y0)
+		return;
+	bounds = hud_port_frame_bounds[hud_port_part];
+	if (!hud_port_frame_drawn[hud_port_part])
+	{
+		bounds[0] = x0;
+		bounds[1] = y0;
+		bounds[2] = x1;
+		bounds[3] = y1;
+		hud_port_frame_drawn[hud_port_part] = TRUE;
+	}
+	else
+	{
+		bounds[0] = MIN(bounds[0], x0);
+		bounds[1] = MIN(bounds[1], y0);
+		bounds[2] = MAX(bounds[2], x1);
+		bounds[3] = MAX(bounds[3], y1);
+	}
+}
+
+/* (hud.c's hud_draw_screen, around a view's HUD) */
+void hud_port_frame_begin(
+	void)
+{
+	short part;
+
+	for (part = 0; part<NUMBER_OF_HUD_PORT_PARTS; part++)
+		hud_port_frame_drawn[part] = FALSE;
+}
+
+void hud_port_frame_end(
+	void)
+{
+	real width = (real)(render.camera.viewport_bounds.x1 - render.camera.viewport_bounds.x0);
+	real height = (real)(render.camera.viewport_bounds.y1 - render.camera.viewport_bounds.y0);
+	real scale = hud_globals_get_scale(FALSE);
+	short part;
+
+	if (local_player_count()!=1 || width<=0.0f || height<=0.0f || scale<=0.0f)
+		return;
+	for (part = 1; part<NUMBER_OF_HUD_PORT_PARTS; part++)
+	{
+		if (hud_port_frame_drawn[part])
+		{
+			real preview_x = hud_port_preview[part][0]*scale;
+			real preview_y = hud_port_preview[part][1]*scale;
+
+			hud_port_rects[part][0] = (hud_port_frame_bounds[part][0]-preview_x)/width;
+			hud_port_rects[part][1] = (hud_port_frame_bounds[part][1]-preview_y)/height;
+			hud_port_rects[part][2] = (hud_port_frame_bounds[part][2]-preview_x)/width;
+			hud_port_rects[part][3] = (hud_port_frame_bounds[part][3]-preview_y)/height;
+			hud_port_rects_known[part] = TRUE;
+		}
+	}
+	hud_port_view_units[0] = width/scale;
+	hud_port_view_units[1] = height/scale;
+}
+
+/* the parts' rectangles, from the shield (hud_draw.h's order without none),
+into rects[4 * 5] as fractions of the view (left, top, right, bottom; all -1
+for a part not drawn yet), and the view's size in HUD units into
+view_units[2]; returns FALSE until the HUD has been drawn */
+boolean hud_port_touch_rects(
+	float *rects,
+	float *view_units)
+{
+	short part;
+	short index;
+
+	for (part = 1; part<NUMBER_OF_HUD_PORT_PARTS; part++)
+	{
+		for (index = 0; index<4; index++)
+			rects[(part-1)*4+index] = hud_port_rects_known[part] ? hud_port_rects[part][index] : -1.0f;
+	}
+	view_units[0] = hud_port_view_units[0];
+	view_units[1] = hud_port_view_units[1];
+
+	return hud_port_view_units[0]>0.0f;
+}
+
+/* where the editor's finger has a part, in HUD units from where its settings
+put it: 0 when not dragged */
+void hud_port_touch_preview(
+	short part,
+	float x,
+	float y)
+{
+	if (part>0 && part<NUMBER_OF_HUD_PORT_PARTS)
+	{
+		hud_port_preview[part][0] = x;
+		hud_port_preview[part][1] = y;
+	}
+}
+
+/* a part moved by the editor, by fractions of the view, until it is drawn
+again where its settings now put it */
+void hud_port_touch_shift(
+	short part,
+	float x,
+	float y)
+{
+	if (part>0 && part<NUMBER_OF_HUD_PORT_PARTS && hud_port_rects_known[part])
+	{
+		hud_port_rects[part][0] += x;
+		hud_port_rects[part][2] += x;
+		hud_port_rects[part][1] += y;
+		hud_port_rects[part][3] += y;
+	}
+}
+
+/* ---------- port: the radar's sweep (TRUCOS, HUD: RADAR, hud.radar_sweep)
+
+Over the motion sensor, in light blue: a sweep turning once every three
+seconds, a cross and two rings. The shapes are plain quads of the white bitmap
+of the maps' default textures (the one the cinematics' letterbox is drawn
+with), tinted by their corners' colors. Sizes are in the HUD's units (the
+tags' 640x480). */
+
+int config_boolean(const char *name);
+
+#define HUD_PORT_ACCENT 0x7FCFFF
+
+static pixel32 hud_port_color(
+	real alpha,
+	pixel32 rgb)
+{
+	return ((pixel32)PIN(fast_ftol_C(alpha*255.0f), 0, 255)<<24) | (rgb & 0x00FFFFFF);
+}
+
+/* the white bitmap of the maps' default 2D textures (multiplicative: white) */
+static struct bitmap_data *hud_port_white_bitmap(
+	void)
+{
+	struct game_globals *game_globals = scenario_get_game_globals();
+	struct game_globals_rasterizer_data *rasterizer_data;
+	long group_index;
+
+	if (!game_globals || game_globals->rasterizer_data.count<1)
+		return NULL;
+	rasterizer_data = TAG_BLOCK_GET_ELEMENT(&game_globals->rasterizer_data, 0, struct game_globals_rasterizer_data);
+	group_index = rasterizer_data->default_textures[0].index;
+	if (group_index==NONE)
+		return NULL;
+
+	return bitmap_group_try_and_get_bitmap(group_index, 1);
+}
+
+/* four corners, around */
+static void hud_port_quad(
+	real_point2d const *points,
+	pixel32 const *colors)
+{
+	struct bitmap_data *map = hud_port_white_bitmap();
+	struct rasterizer_dynamic_screen_geometry_parameters parameters;
+	struct dynamic_screen_vertex vertices[4];
+	short vertex_index;
+	real area = 0.0f;
+
+	if (!map)
+		return;
+	/* (around clockwise on the screen, as the rasterizer draws them: the other
+	way round is not drawn) */
+	for (vertex_index = 0; vertex_index<4; vertex_index++)
+	{
+		real_point2d const *point = &points[vertex_index];
+		real_point2d const *next = &points[(vertex_index+1)&3];
+
+		area += point->x*next->y-next->x*point->y;
+	}
+	for (vertex_index = 0; vertex_index<4; vertex_index++)
+	{
+		short source = area<0.0f ? (4-vertex_index)&3 : vertex_index;
+
+		vertices[vertex_index].position = points[source];
+		vertices[vertex_index].texture_coordinates.x = 0.5f;
+		vertices[vertex_index].texture_coordinates.y = 0.5f;
+		vertices[vertex_index].color = colors[source];
+	}
+	csmemset(&parameters, 0, sizeof(parameters));
+	parameters.map_texture_scale[0].i = 1.0f;
+	parameters.map_texture_scale[0].j = 1.0f;
+	parameters.map_scale[0].i = 1.0f;
+	parameters.map_scale[0].j = 1.0f;
+	parameters.framebuffer_blend_function = _shader_framebuffer_blend_function_alpha_blend;
+	parameters.map[0] = map;
+	rasterizer_psuedo_dynamic_screen_quad_draw(&parameters, vertices);
+	hud_port_note_quad(vertices); /* (where the part is, for the touch editor) */
+
+	return;
+}
+
+static void hud_port_rectangle(
+	real x,
+	real y,
+	real width,
+	real height,
+	pixel32 color)
+{
+	real_point2d points[4];
+	pixel32 colors[4];
+
+	points[0].x = x; points[0].y = y;
+	points[1].x = x+width; points[1].y = y;
+	points[2].x = x+width; points[2].y = y+height;
+	points[3].x = x; points[3].y = y+height;
+	colors[0] = colors[1] = colors[2] = colors[3] = color;
+	hud_port_quad(points, colors);
+
+	return;
+}
+
+/* a ring around (x, y), radius and thickness in pixels */
+static void hud_port_ring(
+	real x,
+	real y,
+	real radius,
+	real thickness,
+	pixel32 color,
+	short segment_count)
+{
+	short index;
+
+	for (index = 0; index<segment_count; index++)
+	{
+		real a0 = (2.0f*_pi)*index/segment_count;
+		real a1 = (2.0f*_pi)*(index+1)/segment_count;
+		real inner = radius-thickness/2, outer = radius+thickness/2;
+		real_point2d points[4];
+		pixel32 colors[4];
+
+		points[0].x = x+(real)cos(a0)*inner; points[0].y = y+(real)sin(a0)*inner;
+		points[1].x = x+(real)cos(a0)*outer; points[1].y = y+(real)sin(a0)*outer;
+		points[2].x = x+(real)cos(a1)*outer; points[2].y = y+(real)sin(a1)*outer;
+		points[3].x = x+(real)cos(a1)*inner; points[3].y = y+(real)sin(a1)*inner;
+		colors[0] = colors[1] = colors[2] = colors[3] = color;
+		hud_port_quad(points, colors);
+	}
+
+	return;
+}
+
+/* ---------- port: the modern HUD (TRUCOS, HUD: ESTILO, hud.modern)
+
+The shield as a long bar in a panel with cut ends at the top middle, thin
+lines running out from it to the sides; the health as a shorter bar under it
+with a cross, red when low; the radar in an eight-sided panel with rings, a
+cross, ticks and the player's arrow, in place of the map's pictures. The
+ammunition and grenades stay the map's. The parts move with the HUD settings
+(hud.<part>_x and _y) and the touch editor like the map's do. Sizes are in
+the HUD's units (the tags' 640x480). */
+
+#define HUD_PORT_PANEL 0x06121E
+#define HUD_PORT_SHIELD 0x3AA8FF
+#define HUD_PORT_BORDER 0x7FD8FF
+#define HUD_PORT_HEALTH 0x55E6C6
+#define HUD_PORT_LOW 0xFF5A4A
+#define HUD_PORT_OVERSHIELD 0xFFE070
+#define HUD_PORT_LIGHT 0xEAF6FF
+#define HUD_PORT_MAXIMUM_POINTS 12
+
+boolean hud_port_style_modern(
+	void)
+{
+	static unsigned long changes = 0;
+	static boolean read = FALSE;
+	static boolean modern = FALSE;
+
+	if (!read || changes!=config_changes())
+	{
+		read = TRUE;
+		changes = config_changes();
+		modern = config_boolean("hud.modern")!=0;
+	}
+	return modern;
+}
+
+/* a and b mixed, t of b */
+static pixel32 hud_port_mix(
+	pixel32 a,
+	pixel32 b,
+	real t)
+{
+	long red = (long)(((a>>16)&0xFF)*(1.0f-t)+((b>>16)&0xFF)*t);
+	long green = (long)(((a>>8)&0xFF)*(1.0f-t)+((b>>8)&0xFF)*t);
+	long blue = (long)((a&0xFF)*(1.0f-t)+(b&0xFF)*t);
+
+	return (pixel32)((PIN(red, 0, 255)<<16)|(PIN(green, 0, 255)<<8)|PIN(blue, 0, 255));
+}
+
+static boolean hud_port_blink_off(
+	void)
+{
+	return (game_time_get()/8)&1;
+}
+
+/* a convex polygon, around clockwise on the screen, filled: a fan from its
+middle */
+static void hud_port_polygon_fill(
+	real_point2d const *points,
+	short count,
+	pixel32 color)
+{
+	real_point2d middle;
+	short index;
+
+	if (count<3)
+		return;
+	middle.x = 0.0f;
+	middle.y = 0.0f;
+	for (index = 0; index<count; index++)
+	{
+		middle.x += points[index].x;
+		middle.y += points[index].y;
+	}
+	middle.x /= count;
+	middle.y /= count;
+	for (index = 0; index<count; index++)
+	{
+		real_point2d quad[4];
+		pixel32 colors[4];
+
+		quad[0] = middle;
+		quad[1] = points[index];
+		quad[2] = points[(index+1)%count];
+		quad[3] = middle;
+		colors[0] = colors[1] = colors[2] = colors[3] = color;
+		hud_port_quad(quad, colors);
+	}
+}
+
+/* its outline moved out by grow (negative: in) */
+static void hud_port_polygon_grow(
+	real_point2d const *points,
+	short count,
+	real grow,
+	real_point2d *result)
+{
+	short index;
+
+	for (index = 0; index<count; index++)
+	{
+		real_point2d const *previous = &points[(index+count-1)%count];
+		real_point2d const *point = &points[index];
+		real_point2d const *next = &points[(index+1)%count];
+		real ax = point->y-previous->y, ay = previous->x-point->x;
+		real bx = next->y-point->y, by = point->x-next->x;
+		real a = (real)sqrt(ax*ax+ay*ay), b = (real)sqrt(bx*bx+by*by);
+		real mx, my, m, cosine;
+
+		if (a<0.0001f || b<0.0001f)
+		{
+			result[index] = *point;
+			continue;
+		}
+		ax /= a; ay /= a; bx /= b; by /= b;
+		mx = ax+bx;
+		my = ay+by;
+		m = (real)sqrt(mx*mx+my*my);
+		if (m<0.0001f)
+		{
+			mx = ax;
+			my = ay;
+		}
+		else
+		{
+			mx /= m;
+			my /= m;
+		}
+		cosine = MAX(mx*ax+my*ay, 0.2f);
+		result[index].x = point->x+mx*grow/cosine;
+		result[index].y = point->y+my*grow/cosine;
+	}
+}
+
+/* a band from the outline grown by inner to it grown by outer */
+static void hud_port_polygon_band(
+	real_point2d const *points,
+	short count,
+	real inner,
+	real outer,
+	pixel32 inner_color,
+	pixel32 outer_color)
+{
+	real_point2d inside[HUD_PORT_MAXIMUM_POINTS];
+	real_point2d outside[HUD_PORT_MAXIMUM_POINTS];
+	short index;
+
+	hud_port_polygon_grow(points, count, inner, inside);
+	hud_port_polygon_grow(points, count, outer, outside);
+	for (index = 0; index<count; index++)
+	{
+		short next = (index+1)%count;
+		real_point2d quad[4];
+		pixel32 colors[4];
+
+		quad[0] = inside[index];
+		quad[1] = outside[index];
+		quad[2] = outside[next];
+		quad[3] = inside[next];
+		colors[0] = colors[3] = inner_color;
+		colors[1] = colors[2] = outer_color;
+		hud_port_quad(quad, colors);
+	}
+}
+
+/* the part of a convex polygon where a*x+b*y <= c (at most count+1 points) */
+static short hud_port_polygon_clip(
+	real_point2d const *points,
+	short count,
+	real a,
+	real b,
+	real c,
+	real_point2d *result)
+{
+	short index;
+	short result_count = 0;
+
+	for (index = 0; index<count && result_count<HUD_PORT_MAXIMUM_POINTS-1; index++)
+	{
+		real_point2d const *point = &points[index];
+		real_point2d const *next = &points[(index+1)%count];
+		real here = a*point->x+b*point->y-c;
+		real there = a*next->x+b*next->y-c;
+
+		if (here<=0.0f)
+			result[result_count++] = *point;
+		if ((here<0.0f && there>0.0f) || (here>0.0f && there<0.0f))
+		{
+			real t = here/(here-there);
+
+			result[result_count].x = point->x+(next->x-point->x)*t;
+			result[result_count].y = point->y+(next->y-point->y)*t;
+			result_count++;
+		}
+	}
+	return result_count;
+}
+
+/* a panel: a soft glow around it, dark inside, its border light blue */
+static void hud_port_panel_polygon(
+	real_point2d const *points,
+	short count,
+	real s)
+{
+	hud_port_polygon_band(points, count, 0.0f, 3.5f*s, hud_port_color(0.28f, HUD_PORT_SHIELD),
+		hud_port_color(0.0f, HUD_PORT_SHIELD));
+	hud_port_polygon_fill(points, count, hud_port_color(0.5f, HUD_PORT_PANEL));
+	hud_port_polygon_band(points, count, -MAX(1.0f, 1.1f*s), 0.0f, hud_port_color(0.9f, HUD_PORT_BORDER),
+		hud_port_color(0.9f, HUD_PORT_BORDER));
+}
+
+/* a bar of a panel's inside lit from its left to the fraction fill, lighter
+at its top; the rest faint */
+static void hud_port_bar(
+	real_point2d const *inside,
+	short count,
+	real left,
+	real right,
+	real fill,
+	pixel32 rgb,
+	real alpha,
+	boolean faint_rest,
+	real glow)
+{
+	real_point2d lit[HUD_PORT_MAXIMUM_POINTS];
+	real_point2d part[HUD_PORT_MAXIMUM_POINTS];
+	real_point2d top[HUD_PORT_MAXIMUM_POINTS];
+	real x = left+(right-left)*PIN(fill, 0.0f, 1.0f);
+	real middle_y;
+	short lit_count, part_count, top_count, index;
+
+	/* (the inside from left on) */
+	part_count = hud_port_polygon_clip(inside, count, -1.0f, 0.0f, -left, part);
+	if (faint_rest)
+	{
+		real_point2d rest[HUD_PORT_MAXIMUM_POINTS];
+		short rest_count = hud_port_polygon_clip(part, part_count, -1.0f, 0.0f, -x, rest);
+
+		hud_port_polygon_fill(rest, rest_count, hud_port_color(0.16f, rgb));
+	}
+	if (fill<=0.0f)
+		return;
+	lit_count = hud_port_polygon_clip(part, part_count, 1.0f, 0.0f, x, lit);
+	/* (a soft glow around the lit part, so that it shines) */
+	if (glow>0.0f)
+		hud_port_polygon_band(lit, lit_count, 0.0f, glow, hud_port_color(alpha*0.45f, rgb), hud_port_color(0.0f, rgb));
+	hud_port_polygon_fill(lit, lit_count, hud_port_color(alpha, rgb));
+	middle_y = 0.0f;
+	for (index = 0; index<lit_count; index++)
+		middle_y += lit[index].y;
+	if (lit_count>0)
+	{
+		real top_y = lit[0].y;
+
+		for (index = 1; index<lit_count; index++)
+			top_y = MIN(top_y, lit[index].y);
+		middle_y = top_y+(middle_y/lit_count-top_y)*0.55f;
+		top_count = hud_port_polygon_clip(lit, lit_count, 0.0f, 1.0f, middle_y, top);
+		hud_port_polygon_fill(top, top_count, hud_port_color(alpha*0.7f, hud_port_mix(rgb, 0xFFFFFF, 0.3f)));
+	}
+}
+
+/* a panel with cut ends, its points */
+static void hud_port_cut_panel(
+	real x,
+	real y,
+	real width,
+	real height,
+	real cut,
+	real_point2d *points)
+{
+	points[0].x = x+cut; points[0].y = y;
+	points[1].x = x+width-cut; points[1].y = y;
+	points[2].x = x+width; points[2].y = y+height*0.5f;
+	points[3].x = x+width-cut; points[3].y = y+height;
+	points[4].x = x+cut; points[4].y = y+height;
+	points[5].x = x; points[5].y = y+height*0.5f;
+}
+
+/* a line, thickness wide */
+static void hud_port_line(
+	real x0,
+	real y0,
+	real x1,
+	real y1,
+	real thickness,
+	pixel32 color)
+{
+	real dx = x1-x0, dy = y1-y0;
+	real length = (real)sqrt(dx*dx+dy*dy);
+	real_point2d quad[4];
+	pixel32 colors[4];
+	real nx, ny;
+
+	if (length<0.0001f)
+		return;
+	nx = -dy/length*thickness*0.5f;
+	ny = dx/length*thickness*0.5f;
+	quad[0].x = x0+nx; quad[0].y = y0+ny;
+	quad[1].x = x1+nx; quad[1].y = y1+ny;
+	quad[2].x = x1-nx; quad[2].y = y1-ny;
+	quad[3].x = x0-nx; quad[3].y = y0-ny;
+	colors[0] = colors[1] = colors[2] = colors[3] = color;
+	hud_port_quad(quad, colors);
+}
+
+/* a line from color_start to color_end */
+static void hud_port_line_fade(
+	real x0,
+	real y0,
+	real x1,
+	real y1,
+	real thickness,
+	pixel32 color_start,
+	pixel32 color_end)
+{
+	real dx = x1-x0, dy = y1-y0;
+	real length = (real)sqrt(dx*dx+dy*dy);
+	real_point2d quad[4];
+	pixel32 colors[4];
+	real nx, ny;
+
+	if (length<0.0001f)
+		return;
+	nx = -dy/length*thickness*0.5f;
+	ny = dx/length*thickness*0.5f;
+	quad[0].x = x0+nx; quad[0].y = y0+ny;
+	quad[1].x = x1+nx; quad[1].y = y1+ny;
+	quad[2].x = x1-nx; quad[2].y = y1-ny;
+	quad[3].x = x0-nx; quad[3].y = y0-ny;
+	colors[0] = colors[3] = color_start;
+	colors[1] = colors[2] = color_end;
+	hud_port_quad(quad, colors);
+}
+
+/* a ring with a soft glow: a wide faint band, then its line */
+static void hud_port_soft_ring(
+	real x,
+	real y,
+	real radius,
+	real line,
+	real alpha,
+	short segment_count)
+{
+	hud_port_ring(x, y, radius, line*3.0f, hud_port_color(alpha*0.22f, HUD_PORT_SHIELD), segment_count);
+	hud_port_ring(x, y, radius, line, hud_port_color(alpha, HUD_PORT_BORDER), segment_count);
+}
+
+/* the window's edges in the view's pixels */
+static void hud_port_window(
+	real *x0,
+	real *y0,
+	real *x1)
+{
+	*x0 = (real)(render.camera.window_bounds.x0-render.camera.viewport_bounds.x0);
+	*y0 = (real)(render.camera.window_bounds.y0-render.camera.viewport_bounds.y0);
+	*x1 = (real)(render.camera.window_bounds.x1-render.camera.viewport_bounds.x0);
+}
+
+/* a convex polygon filled with a colour from top to bottom (each point's
+colour by its height, between top and bottom) */
+static void hud_port_polygon_gradient(
+	real_point2d const *points,
+	short count,
+	real top,
+	real bottom,
+	pixel32 top_color,
+	pixel32 bottom_color)
+{
+	real_point2d middle;
+	pixel32 colors[HUD_PORT_MAXIMUM_POINTS];
+	pixel32 middle_color;
+	real span = bottom-top;
+	short index;
+
+	if (count<3)
+		return;
+	middle.x = 0.0f;
+	middle.y = 0.0f;
+	for (index = 0; index<count; index++)
+	{
+		middle.x += points[index].x;
+		middle.y += points[index].y;
+	}
+	middle.x /= count;
+	middle.y /= count;
+	for (index = 0; index<count; index++)
+	{
+		real t = span>0.0f ? PIN((points[index].y-top)/span, 0.0f, 1.0f) : 0.0f;
+
+		colors[index] = ((pixel32)fast_ftol_C((((top_color>>24)&0xFF)*(1.0f-t)+((bottom_color>>24)&0xFF)*t))<<24) |
+			hud_port_mix(top_color, bottom_color, t);
+	}
+	{
+		real t = span>0.0f ? PIN((middle.y-top)/span, 0.0f, 1.0f) : 0.0f;
+
+		middle_color = ((pixel32)fast_ftol_C((((top_color>>24)&0xFF)*(1.0f-t)+((bottom_color>>24)&0xFF)*t))<<24) |
+			hud_port_mix(top_color, bottom_color, t);
+	}
+	for (index = 0; index<count; index++)
+	{
+		real_point2d quad[4];
+		pixel32 quad_colors[4];
+
+		quad[0] = middle;
+		quad[1] = points[index];
+		quad[2] = points[(index+1)%count];
+		quad[3] = middle;
+		quad_colors[0] = quad_colors[3] = middle_color;
+		quad_colors[1] = colors[index];
+		quad_colors[2] = colors[(index+1)%count];
+		hud_port_quad(quad, quad_colors);
+	}
+}
+
+/* a solid bar in relief: its shape lit from its left to the fraction fill
+(the rest dark), lighter at its top and darker at its bottom, a thin
+highlight near its top, a light rim and a soft glow */
+static void hud_port_relief_bar(
+	real_point2d const *shape,
+	short count,
+	real left,
+	real right,
+	real top,
+	real bottom,
+	real fill,
+	pixel32 rgb,
+	real alpha,
+	real s,
+	boolean rim)
+{
+	real_point2d lit[HUD_PORT_MAXIMUM_POINTS];
+	real_point2d band[HUD_PORT_MAXIMUM_POINTS];
+	real x = left+(right-left)*PIN(fill, 0.0f, 1.0f);
+	real height = bottom-top;
+	short lit_count, band_count;
+	boolean background = alpha>=0.0f;
+
+	alpha = background ? alpha : -alpha;
+
+	if (fill>0.0f)
+	{
+		lit_count = hud_port_polygon_clip(shape, count, 1.0f, 0.0f, x, lit);
+		hud_port_polygon_band(lit, lit_count, 0.0f, 3.0f*s, hud_port_color(alpha*0.4f, rgb), hud_port_color(0.0f, rgb));
+		/* (lighter in its upper half, darker in its lower) */
+		band_count = hud_port_polygon_clip(lit, lit_count, 0.0f, 1.0f, top+height*0.5f, band);
+		hud_port_polygon_gradient(band, band_count, top, top+height*0.5f,
+			hud_port_color(alpha, hud_port_mix(rgb, 0xFFFFFF, 0.45f)), hud_port_color(alpha, rgb));
+		band_count = hud_port_polygon_clip(lit, lit_count, 0.0f, -1.0f, -(top+height*0.5f), band);
+		hud_port_polygon_gradient(band, band_count, top+height*0.5f, bottom,
+			hud_port_color(alpha, rgb), hud_port_color(alpha, hud_port_mix(rgb, 0x002050, 0.35f)));
+		/* (the highlight: a thin light line a quarter down) */
+		{
+			real_point2d line[HUD_PORT_MAXIMUM_POINTS];
+			short line_count;
+
+			band_count = hud_port_polygon_clip(lit, lit_count, 0.0f, -1.0f, -(top+height*0.2f), band);
+			line_count = hud_port_polygon_clip(band, band_count, 0.0f, 1.0f, top+height*0.2f+MAX(1.0f, 0.8f*s), line);
+			hud_port_polygon_fill(line, line_count, hud_port_color(alpha*0.55f, 0xFFFFFF));
+		}
+	}
+	/* (the empty part dark: not for an overshield, drawn over the full shield,
+	whose blue shows where the overshield is gone: a negative alpha) */
+	if (fill<1.0f && background)
+	{
+		band_count = hud_port_polygon_clip(shape, count, -1.0f, 0.0f, -x, band);
+		hud_port_polygon_fill(band, band_count, hud_port_color(0.55f, HUD_PORT_PANEL));
+	}
+	if (rim)
+	{
+		hud_port_polygon_band(shape, count, -MAX(1.0f, 1.2f*s), 0.0f,
+			hud_port_color(0.85f*MAX(alpha, 0.5f), hud_port_mix(rgb, 0xFFFFFF, 0.55f)),
+			hud_port_color(0.85f*MAX(alpha, 0.5f), hud_port_mix(rgb, 0xFFFFFF, 0.55f)));
+	}
+}
+
+/* (hud_unit.c) the shield and the health, each negative when not shown */
+void hud_port_style_unit(
+	short local_player_index,
+	real shield_vitality,
+	real body_vitality)
+{
+	short part = hud_port_part;
+	real s = hud_globals_get_scale(local_player_count()>1);
+	real window_x0, window_y0, window_x1, middle;
+	/* the shield's size, in HUD units (the health's place goes by it) */
+	real const shield_width = 270.0f, shield_height = 18.0f, shield_top = 22.0f;
+
+	if (!hud_port_style_modern())
+		return;
+	if (s<=0.0f)
+		s = 1.0f;
+	hud_port_window(&window_x0, &window_y0, &window_x1);
+	middle = (window_x0+window_x1)*0.5f;
+
+	if (shield_vitality>=0.0f)
+	{
+		real width = shield_width*s, height = shield_height*s, cut = 11.0f*s;
+		real x = middle-width*0.5f+hud_port_offset(_hud_port_part_shield, 0)*s;
+		real y = window_y0+shield_top*s+hud_port_offset(_hud_port_part_shield, 1)*s;
+		real line = MAX(1.0f, 0.8f*s);
+		pixel32 lines = hud_port_color(0.55f, HUD_PORT_BORDER);
+		real_point2d points[6];
+		real alpha = shield_vitality<0.25f && hud_port_blink_off() ? 0.35f : 1.0f;
+
+		/* (the visor's lines: from the sides a little above the shield, down
+		in a slant before its ends, and along under it; not part of its box in
+		the touch editor, their length following where it is) */
+		{
+			real high = y-3.0f*s, low = y+height+9.0f*s;
+			real slant = 46.0f*s;
+			real reach = MAX(40.0f*s, MIN(x-window_x0, window_x1-(x+width))-10.0f*s);
+
+			hud_port_part = _hud_port_part_none;
+			hud_port_line_fade(x-slant, high, x-slant-reach, high, line, lines, hud_port_color(0.0f, HUD_PORT_BORDER));
+			hud_port_line(x-slant, high, x-4.0f*s, low, line, lines);
+			hud_port_line(x-4.0f*s, low, x+width+4.0f*s, low, line, hud_port_color(0.35f, HUD_PORT_BORDER));
+			hud_port_line(x+width+4.0f*s, low, x+width+slant, high, line, lines);
+			hud_port_line_fade(x+width+slant, high, x+width+slant+reach, high, line, lines,
+				hud_port_color(0.0f, HUD_PORT_BORDER));
+			hud_port_part = _hud_port_part_shield;
+		}
+		hud_port_cut_panel(x, y, width, height, cut, points);
+		hud_port_relief_bar(points, 6, x, x+width, y, y+height, MIN(shield_vitality, 1.0f), HUD_PORT_SHIELD,
+			alpha, s, shield_vitality<=1.0f);
+		if (shield_vitality>1.0f)
+		{
+			hud_port_relief_bar(points, 6, x, x+width, y, y+height, MIN((shield_vitality-1.0f)/2.0f, 1.0f),
+				HUD_PORT_OVERSHIELD, -1.0f, s, TRUE);
+		}
+	}
+
+	if (body_vitality>=0.0f)
+	{
+		real icon_width = 22.0f*s, icon_height = 16.0f*s;
+		real bar_width = 130.0f*s, bar_height = 13.0f*s;
+		real total = icon_width+bar_width-2.0f*s;
+		real x = middle-total*0.5f+hud_port_offset(_hud_port_part_health, 0)*s;
+		real y = window_y0+(shield_top+shield_height+7.0f)*s+hud_port_offset(_hud_port_part_health, 1)*s;
+		boolean low = body_vitality<0.3f;
+		pixel32 rgb = low ? HUD_PORT_LOW : HUD_PORT_HEALTH;
+		real alpha = body_vitality<0.25f && hud_port_blink_off() ? 0.35f : 1.0f;
+		real bar_x = x+icon_width-2.0f*s, bar_y = y+(icon_height-bar_height)*0.5f;
+		real_point2d panel[6], inside[6], icon[6];
+
+		hud_port_part = _hud_port_part_health;
+		/* the bar's panel: dark, its right end cut, and the bar in it */
+		panel[0].x = bar_x; panel[0].y = bar_y;
+		panel[1].x = bar_x+bar_width-6.5f*s; panel[1].y = bar_y;
+		panel[2].x = bar_x+bar_width; panel[2].y = bar_y+bar_height*0.5f;
+		panel[3].x = bar_x+bar_width-6.5f*s; panel[3].y = bar_y+bar_height;
+		panel[4].x = bar_x; panel[4].y = bar_y+bar_height;
+		panel[5].x = bar_x; panel[5].y = bar_y+bar_height*0.5f;
+		hud_port_polygon_band(panel, 6, 0.0f, 2.5f*s, hud_port_color(0.25f, HUD_PORT_SHIELD),
+			hud_port_color(0.0f, HUD_PORT_SHIELD));
+		hud_port_polygon_fill(panel, 6, hud_port_color(0.6f, HUD_PORT_PANEL));
+		hud_port_polygon_band(panel, 6, -MAX(1.0f, 0.7f*s), 0.0f, hud_port_color(0.6f, HUD_PORT_BORDER),
+			hud_port_color(0.6f, HUD_PORT_BORDER));
+		hud_port_polygon_grow(panel, 6, -3.0f*s, inside);
+		hud_port_relief_bar(inside, 6, bar_x+6.0f*s, bar_x+bar_width-7.0f*s, bar_y+3.0f*s, bar_y+bar_height-3.0f*s,
+			body_vitality, rgb, alpha, s, FALSE);
+		/* the cross in its own six-sided shape, at the bar's left */
+		hud_port_cut_panel(x, y, icon_width, icon_height, 6.5f*s, icon);
+		hud_port_polygon_band(icon, 6, 0.0f, 2.5f*s, hud_port_color(0.3f, HUD_PORT_SHIELD),
+			hud_port_color(0.0f, HUD_PORT_SHIELD));
+		hud_port_polygon_fill(icon, 6, hud_port_color(0.75f, HUD_PORT_PANEL));
+		hud_port_polygon_band(icon, 6, -MAX(1.0f, 0.8f*s), 0.0f, hud_port_color(0.85f, HUD_PORT_BORDER),
+			hud_port_color(0.85f, HUD_PORT_BORDER));
+		{
+			real cross_x = x+icon_width*0.5f, cross_y = y+icon_height*0.5f;
+			pixel32 cross = hud_port_color(1.0f, low ? HUD_PORT_LOW : 0xCFF6FF);
+
+			hud_port_rectangle(cross_x-5.0f*s, cross_y-1.6f*s, 10.0f*s, 3.2f*s, cross);
+			hud_port_rectangle(cross_x-1.6f*s, cross_y-5.0f*s, 3.2f*s, 10.0f*s, cross);
+		}
+	}
+
+	hud_port_part = part;
+}
+
+/* ---------- port: the round radar (TRUCOS, HUD: RADAR, hud.radar_round)
+
+In place of the map's pictures: a see-through teal disc with a glowing edge,
+two thin rings and short dashes inside, and a small hollow red diamond on its
+edge toward where the guide arrow points. The blips are drawn over it (the
+map's), and the sweep (hud.radar_sweep) turns in teal. */
+
+#define HUD_PORT_ROUND 0x6FD6CB
+#define HUD_PORT_ROUND_LIGHT 0xBDF4EC
+#define HUD_PORT_ROUND_MARK 0xE5323A
+#define HUD_PORT_ROUND_SHADE 0x03161A
+
+boolean hud_port_radar_round(
+	void)
+{
+	static unsigned long changes = 0;
+	static boolean read = FALSE;
+	static boolean enabled = FALSE;
+
+	if (!read || changes!=config_changes())
+	{
+		read = TRUE;
+		changes = config_changes();
+		enabled = config_boolean("hud.radar_round")!=0;
+	}
+	return enabled;
+}
+
+real hud_port_radar_size(
+	void)
+{
+	static unsigned long changes = 0;
+	static boolean read = FALSE;
+	static long size = 100;
+
+	if (!read || changes!=config_changes())
+	{
+		read = TRUE;
+		changes = config_changes();
+		size = PIN(config_integer("hud.radar_size"), 70, 150);
+	}
+	if (!hud_port_radar_round() && !hud_port_style_modern())
+		return 1.0f;
+	return (real)size/100.0f;
+}
+
+/* a ring from radius inner (inner_color) to radius outer (outer_color) */
+static void hud_port_ring_fade(
+	real x,
+	real y,
+	real inner,
+	real outer,
+	pixel32 inner_color,
+	pixel32 outer_color,
+	short segment_count)
+{
+	short index;
+
+	for (index = 0; index<segment_count; index++)
+	{
+		real a0 = (2.0f*_pi)*index/segment_count;
+		real a1 = (2.0f*_pi)*(index+1)/segment_count;
+		real_point2d points[4];
+		pixel32 colors[4];
+
+		points[0].x = x+(real)cos(a0)*inner; points[0].y = y+(real)sin(a0)*inner;
+		points[1].x = x+(real)cos(a0)*outer; points[1].y = y+(real)sin(a0)*outer;
+		points[2].x = x+(real)cos(a1)*outer; points[2].y = y+(real)sin(a1)*outer;
+		points[3].x = x+(real)cos(a1)*inner; points[3].y = y+(real)sin(a1)*inner;
+		colors[0] = colors[3] = inner_color;
+		colors[1] = colors[2] = outer_color;
+		hud_port_quad(points, colors);
+	}
+}
+
+/* the guide arrow's direction for the round radar's diamond, each local
+player's: the game time it was last told and the angle */
+static long hud_port_radar_objective_times[4] = { NONE, NONE, NONE, NONE };
+static real hud_port_radar_objective_angles[4];
+
+void hud_port_radar_objective(
+	short local_player_index,
+	real angle)
+{
+	hud_port_radar_objective_times[local_player_index & 3] = game_time_get();
+	hud_port_radar_objective_angles[local_player_index & 3] = angle;
+}
+
+/* a diamond's points around (x, y), half its length across, its tips along
+(dx, dy) (a unit vector) and across it */
+static void hud_port_diamond_points(
+	real x,
+	real y,
+	real half,
+	real dx,
+	real dy,
+	real_point2d *points)
+{
+	points[0].x = x+dx*half; points[0].y = y+dy*half;
+	points[1].x = x-dy*half; points[1].y = y+dx*half;
+	points[2].x = x-dx*half; points[2].y = y-dy*half;
+	points[3].x = x+dy*half; points[3].y = y-dx*half;
+}
+
+static void hud_port_diamond(
+	real x,
+	real y,
+	real half,
+	real dx,
+	real dy,
+	pixel32 color)
+{
+	real_point2d points[4];
+	pixel32 colors[4];
+
+	hud_port_diamond_points(x, y, half, dx, dy, points);
+	colors[0] = colors[1] = colors[2] = colors[3] = color;
+	hud_port_quad(points, colors);
+}
+
+/* a short dash across the radius at angle, at distance from (x, y), length
+long, along the circle */
+static void hud_port_radar_tick(
+	real x,
+	real y,
+	real angle,
+	real distance,
+	real length,
+	real thickness,
+	pixel32 color)
+{
+	real cx = x+(real)cos(angle)*distance, cy = y+(real)sin(angle)*distance;
+	real tx = -(real)sin(angle)*length*0.5f, ty = (real)cos(angle)*length*0.5f;
+
+	hud_port_line(cx-tx, cy-ty, cx+tx, cy+ty, thickness, color);
+}
+
+static void hud_port_radar_round_draw(
+	short local_player_index,
+	real x,
+	real y,
+	real r,
+	real s)
+{
+	real big = r*1.1f;
+	real line = MAX(1.0f, 0.9f*s);
+	short index;
+
+	/* the glow outside the edge */
+	hud_port_ring_fade(x, y, big, big+9.0f*s, hud_port_color(0.34f, HUD_PORT_ROUND),
+		hud_port_color(0.0f, HUD_PORT_ROUND), 64);
+	/* a dark base under the disc, so that it shows over bright skies too */
+	hud_port_ring_fade(x, y, 0.0f, big, hud_port_color(0.30f, HUD_PORT_ROUND_SHADE),
+		hud_port_color(0.42f, HUD_PORT_ROUND_SHADE), 48);
+	/* the disc: a see-through teal, a little stronger towards the edge, and the
+	middle circle a little lighter */
+	hud_port_ring_fade(x, y, 0.0f, big*0.36f, hud_port_color(0.27f, HUD_PORT_ROUND),
+		hud_port_color(0.27f, HUD_PORT_ROUND), 32);
+	hud_port_ring_fade(x, y, big*0.36f, big*0.68f, hud_port_color(0.21f, HUD_PORT_ROUND),
+		hud_port_color(0.23f, HUD_PORT_ROUND), 48);
+	hud_port_ring_fade(x, y, big*0.68f, big, hud_port_color(0.23f, HUD_PORT_ROUND),
+		hud_port_color(0.34f, HUD_PORT_ROUND), 64);
+
+	/* the two rings inside */
+	hud_port_ring(x, y, big*0.68f, 0.9f*line, hud_port_color(0.42f, HUD_PORT_ROUND), 48);
+	hud_port_ring(x, y, big*0.36f, 0.9f*line, hud_port_color(0.36f, HUD_PORT_ROUND), 32);
+
+	/* short dashes along the circles: eight between the middle ring and the
+	edge, four inside the middle ring */
+	for (index = 0; index<8; index++)
+		hud_port_radar_tick(x, y, (_pi/4.0f)*index-_pi/2.0f, big*0.85f, big*0.07f, 0.9f*line,
+			hud_port_color(0.5f, HUD_PORT_ROUND_LIGHT));
+	for (index = 0; index<4; index++)
+		hud_port_radar_tick(x, y, (_pi/2.0f)*index-_pi/2.0f, big*0.52f, big*0.06f, 0.9f*line,
+			hud_port_color(0.42f, HUD_PORT_ROUND_LIGHT));
+
+	/* the edge: a soft band and a bright line */
+	hud_port_ring(x, y, big, 3.0f*line, hud_port_color(0.28f, HUD_PORT_ROUND), 64);
+	/* (a thin dark line just outside it, so that it shows over bright skies) */
+	hud_port_ring(x, y, big+1.4f*line, 1.0f*line, hud_port_color(0.5f, HUD_PORT_ROUND_SHADE), 64);
+	hud_port_ring(x, y, big, 1.1f*line, hud_port_color(0.88f, HUD_PORT_ROUND_LIGHT), 64);
+
+	/* the red diamond on the edge, toward where the guide arrow points (TRUCOS,
+	GUIA): a red rim, light inside, a small one in the middle, its tips along
+	the radius. Not drawn when the arrow is not (no target, or the guide off) */
+	{
+		long told = hud_port_radar_objective_times[local_player_index & 3];
+		long now = game_time_get();
+
+		if (told!=NONE && now>=told && now-told<=2)
+		{
+			real angle = hud_port_radar_objective_angles[local_player_index & 3];
+			/* (the player's facing is up; an angle to the left is to the left) */
+			real dx = -(real)sin(angle), dy = -(real)cos(angle);
+			real mark_x = x+dx*big, mark_y = y+dy*big;
+			real outer = 4.6f*s, inner = outer-MAX(1.0f, 1.1f*s);
+			real_point2d points[4];
+
+			hud_port_diamond_points(mark_x, mark_y, outer, dx, dy, points);
+			hud_port_diamond(mark_x, mark_y, inner, dx, dy,
+				hud_port_color(0.35f, hud_port_mix(HUD_PORT_ROUND_MARK, 0xFFFFFF, 0.6f)));
+			hud_port_polygon_band(points, 4, -(outer-inner), 0.0f, hud_port_color(0.95f, HUD_PORT_ROUND_MARK),
+				hud_port_color(0.95f, HUD_PORT_ROUND_MARK));
+			hud_port_diamond(mark_x, mark_y, 1.5f*s, dx, dy, hud_port_color(0.95f, HUD_PORT_ROUND_MARK));
+		}
+	}
+}
