+/* whether a tag's name has a folder in it, whatever the case of its letters */
+static boolean cheat_port_name_has(
+	char const *name,
+	char const *folder)
+{
+	for (; name && *name; name++)
+	{
+		short index;
+
+		for (index = 0; folder[index] && name[index] &&
+			(name[index]|0x20)==(folder[index]|0x20); index++)
+			;
+		if (!folder[index])
+			return TRUE;
+	}
+
+	return FALSE;
+}
+
+static void cheat_port_one(
+	char const *setting,
+	unsigned long group,
+	struct cheat_port_choice const *choices,
+	short choice_count,
+	boolean vehicle)
+{
+	char const *setting_value = config_string(setting);
+	char value[32];
+	short choice_index;
+
+	if (!setting_value || !*setting_value || !strcmp(setting_value, "none"))
+		return;
+	/* (a copy: writing the setting back changes the string it gives) */
+	strncpy(value, setting_value, sizeof(value)-1);
+	value[sizeof(value)-1] = 0;
+	config_write(setting, "none");
+	/* "next": the map's weapons (those of the weapons' folder: not the
+	vehicles' guns) or vehicles one after another, each use the next, with its
+	tag's name shown: whatever the map has, the choices above or not */
+	if (!strcmp(value, "next"))
+	{
+		static short next_index[2] = { 0, 0 };
+		struct tag_iterator iterator;
+		struct tag_reference reference;
+		long tag_index;
+		short count = 0, pass;
+
+		reference.index = NONE;
+		for (pass = 0; pass<2 && reference.index==NONE; pass++)
+		{
+			short index = 0;
+
+			tag_iterator_new(&iterator, group);
+			for (tag_index = tag_iterator_next(&iterator); tag_index!=NONE; tag_index = tag_iterator_next(&iterator))
+			{
+				if (!vehicle && !cheat_port_name_has(tag_get_name(tag_index), "weapons\\"))
+					continue;
+				if (pass==1 && index==next_index[vehicle]%count)
+				{
+					reference.index = tag_index;
+					break;
+				}
+				index++;
+			}
+			if (pass==0 && (count = index)==0)
+				break;
+		}
+		if (reference.index!=NONE)
+		{
+			next_index[vehicle] = (short)((next_index[vehicle]%count)+1);
+			terminal_printf(global_real_argb_orange, "%d/%d: %s", next_index[vehicle], count, tag_get_name(reference.index));
+			if (vehicle)
+				cheat_objects_spread(&reference, 1, 8.0f, 6.0f);
+			else
+				cheat_objects(&reference, 1);
+		}
+		return;
+	}
+	for (choice_index = 0; choice_index<choice_count && strcmp(choices[choice_index].value, value); choice_index++)
+		;
+	if (choice_index<choice_count)
+	{
+		struct tag_iterator iterator;
+		struct tag_reference reference;
+		long tag_index;
+
+		reference.index = NONE;
+		tag_iterator_new(&iterator, group);
+		for (tag_index = tag_iterator_next(&iterator);
+			tag_index!=NONE && reference.index==NONE;
+			tag_index = tag_iterator_next(&iterator))
+		{
+			if (cheat_port_name_has(tag_get_name(tag_index), choices[choice_index].folder))
+				reference.index = tag_index;
+		}
+		if (reference.index==NONE)
+		{
+			terminal_printf(global_real_argb_orange, "%s: no esta en este mapa", choices[choice_index].shown);
+		}
+		else if (vehicle)
+		{
+			cheat_objects_spread(&reference, 1, 8.0f, 6.0f);
+		}
+		else
+		{
+			cheat_objects(&reference, 1);
+		}
+	}
+
+	return;
+}
