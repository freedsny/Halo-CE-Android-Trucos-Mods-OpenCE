+/* (hud_unit.c) the radar's panel, under its blips: centred on the blips'
+centre */
+void hud_port_radar_panel(
+	short local_player_index,
+	point2d const *center,
+	real radius_units)
+{
+	real s = hud_globals_get_scale(local_player_count()>1);
+	real r, half, cut, x, y, line;
+	real_point2d points[8];
+
+	if (!center || (!hud_port_style_modern() && !hud_port_radar_round()))
+		return;
+	if (s<=0.0f)
+		s = 1.0f;
+	if (radius_units<15.0f || radius_units>120.0f)
+		radius_units = 46.0f;
+	r = radius_units*s;
+	if (hud_port_radar_round())
+	{
+		hud_port_radar_round_draw(local_player_index, (real)center->x, (real)center->y, r, s);
+		return;
+	}
+	half = r*1.18f;
+	cut = half*0.32f;
+	x = (real)center->x;
+	y = (real)center->y;
+	line = MAX(1.0f, 0.9f*s);
+
+	points[0].x = x-half+cut; points[0].y = y-half;
+	points[1].x = x+half-cut; points[1].y = y-half;
+	points[2].x = x+half; points[2].y = y-half+cut;
+	points[3].x = x+half; points[3].y = y+half-cut;
+	points[4].x = x+half-cut; points[4].y = y+half;
+	points[5].x = x-half+cut; points[5].y = y+half;
+	points[6].x = x-half; points[6].y = y+half-cut;
+	points[7].x = x-half; points[7].y = y-half+cut;
+	hud_port_panel_polygon(points, 8, s);
+	/* (a second, thin border inside, and the middle a little lighter) */
+	hud_port_polygon_band(points, 8, -3.6f*s, -3.6f*s+MAX(1.0f, 0.7f*s), hud_port_color(0.35f, HUD_PORT_BORDER),
+		hud_port_color(0.35f, HUD_PORT_BORDER));
+	{
+		real_point2d middle[8];
+
+		hud_port_polygon_grow(points, 8, -half*0.45f, middle);
+		hud_port_polygon_fill(middle, 8, hud_port_color(0.08f, HUD_PORT_SHIELD));
+	}
+
+	/* the rings (smooth, with a soft glow), the cross and the ticks at the
+	panel's sides */
+	hud_port_soft_ring(x, y, r, 1.2f*line, 0.6f, 64);
+	hud_port_soft_ring(x, y, r*0.66f, 0.8f*line, 0.32f, 48);
+	hud_port_soft_ring(x, y, r*0.33f, 0.8f*line, 0.32f, 32);
+	hud_port_line_fade(x, y, x-r, y, 0.8f*line, hud_port_color(0.3f, HUD_PORT_BORDER), hud_port_color(0.05f, HUD_PORT_BORDER));
+	hud_port_line_fade(x, y, x+r, y, 0.8f*line, hud_port_color(0.3f, HUD_PORT_BORDER), hud_port_color(0.05f, HUD_PORT_BORDER));
+	hud_port_line_fade(x, y, x, y-r, 0.8f*line, hud_port_color(0.3f, HUD_PORT_BORDER), hud_port_color(0.05f, HUD_PORT_BORDER));
+	hud_port_line_fade(x, y, x, y+r, 0.8f*line, hud_port_color(0.3f, HUD_PORT_BORDER), hud_port_color(0.05f, HUD_PORT_BORDER));
+	hud_port_line(x, y-half+1.0f*s, x, y-half+6.0f*s, 1.5f*line, hud_port_color(0.9f, HUD_PORT_BORDER));
+	hud_port_line(x, y+half-1.0f*s, x, y+half-6.0f*s, 1.5f*line, hud_port_color(0.9f, HUD_PORT_BORDER));
+	hud_port_line(x-half+1.0f*s, y, x-half+6.0f*s, y, 1.5f*line, hud_port_color(0.9f, HUD_PORT_BORDER));
+	hud_port_line(x+half-1.0f*s, y, x+half-6.0f*s, y, 1.5f*line, hud_port_color(0.9f, HUD_PORT_BORDER));
+
+	/* the player's arrow, with a halo */
+	{
+		real_point2d arrow[3];
+
+		arrow[0].x = x; arrow[0].y = y-6.0f*s;
+		arrow[1].x = x+5.0f*s; arrow[1].y = y+4.0f*s;
+		arrow[2].x = x-5.0f*s; arrow[2].y = y+4.0f*s;
+		hud_port_polygon_band(arrow, 3, 0.0f, 2.5f*s, hud_port_color(0.45f, HUD_PORT_SHIELD),
+			hud_port_color(0.0f, HUD_PORT_SHIELD));
+		hud_port_polygon_fill(arrow, 3, hud_port_color(0.95f, HUD_PORT_LIGHT));
+	}
+}
