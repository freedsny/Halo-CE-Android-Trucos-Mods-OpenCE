+/* ---------- port: the teleport (TRUCOS, TELETRANSPORTE, cheats.teleport)
+
+The touch controls' "Ir" button (TouchControls.java), shown while the cheat is
+on and the guide arrow has somewhere to go, takes the player there: onto the
+floor a little inside the mission's objective (its nearest point is often at a
+wall), or beside the ally or enemy it points to. The game's own teleport
+(player_teleport: out of a vehicle, fitted where there is room). Only in a
+game that is not on a network. The push comes from the input (touch_input.c)
+and is done at the next tick (cheats.c) */
+#define GUIDE_TELEPORT_SHOWN_MILLISECONDS 600
+#define GUIDE_TELEPORT_INSIDE 0.3f
+#define GUIDE_TELEPORT_BESIDE 1.5f
+#define GUIDE_TELEPORT_RINGS 5
+#define GUIDE_TELEPORT_RING_STEPS 8
+#define GUIDE_TELEPORT_RING_SPACING 2.f
+
+static boolean hud_port_guide_teleport_wanted = FALSE;
+/* where the player was before the teleport, and how many ticks more the
+teleport is watched: a player who lands outside the level (where he would
+fall forever, with no HUD) is put back there */
+#define GUIDE_TELEPORT_WATCH_TICKS (3*TICKS_PER_SECOND)
+static real_point3d hud_port_guide_teleport_from;
+static short hud_port_guide_teleport_watch = 0;
+
+/* whether a point is inside the level's loaded structure (a cluster of it) */
+static boolean hud_port_guide_inside_level(
+	real_point3d const *point)
+{
+	struct location location;
+
+	scenario_location_from_point(&location, point);
+	return location.cluster_index!=NONE;
+}
+
+/* whether the guide's target is in the loaded part of the level: the point,
+the middle of its volume, or between the two */
+static boolean hud_port_guide_target_reachable(
+	real_point3d const *target)
+{
+	real_point3d middle;
+
+	if (hud_port_guide_inside_level(target))
+		return TRUE;
+	if (!hud_port_guide_target_is_volume)
+		return FALSE;
+	middle.x = (target->x+hud_port_guide_target_center.x)*0.5f;
+	middle.y = (target->y+hud_port_guide_target_center.y)*0.5f;
+	middle.z = (target->z+hud_port_guide_target_center.z)*0.5f;
+	return hud_port_guide_inside_level(&middle) || hud_port_guide_inside_level(&hud_port_guide_target_center);
+}
+
+/* a teleport to a point inside the level, else none. The game's teleport
+(player_teleport) kills a player it cannot fit, or who would land on a zone
+that loads another part of the level (a BSP switch): such a spot is tried
+first without moving him (biped_fix_position's dont_teleport), and left */
+/* (players.c's: the scenario's records of the zones that switch the BSP) */
+struct scenario_bsp_switch_trigger_volume
+{
+	short trigger_volume_index;
+	short source_structure_bsp_index;
+	short destination_structure_bsp_index;
+	short cutscene_flag_index;
+};
+
+static boolean hud_port_guide_teleport_to(
+	long player_index,
+	real_point3d const *point)
+{
+	long unit_index = player_get(player_index)->unit_index;
+	struct scenario *scenario = global_scenario_get();
+	real_point3d final_point;
+	short index;
+
+	if (unit_index==NONE || !biped_try_and_get(unit_index) || !hud_port_guide_inside_level(point))
+		return FALSE;
+	final_point = *point;
+	if (!biped_fix_position(unit_index, NONE, point, &final_point, 2.f, FALSE, TRUE, TRUE) ||
+		!hud_port_guide_inside_level(&final_point))
+	{
+		return FALSE;
+	}
+	for (index = 0; index<scenario->bsp_switch_trigger_volumes.count; index++)
+	{
+		struct scenario_bsp_switch_trigger_volume *volume = TAG_BLOCK_GET_ELEMENT(
+			&scenario->bsp_switch_trigger_volumes, index, struct scenario_bsp_switch_trigger_volume);
+
+		if (volume->source_structure_bsp_index==global_structure_bsp_index &&
+			(scenario_trigger_volume_test_point(volume->trigger_volume_index, point) ||
+				scenario_trigger_volume_test_point(volume->trigger_volume_index, &final_point)))
+		{
+			return FALSE;
+		}
+	}
+
+	return player_teleport(player_index, NONE, point);
+}
+
+static boolean hud_port_guide_teleport_allowed(
+	void)
+{
+	return game_connection()==_game_connection_local && !network_game_distributed_client() &&
+		config_boolean("cheats.teleport");
+}
+
+boolean hud_port_guide_teleport_ready(
+	void)
+{
+	return hud_port_guide_teleport_allowed() &&
+		system_milliseconds()-hud_port_guide_drawn_at<GUIDE_TELEPORT_SHOWN_MILLISECONDS;
+}
+
+void hud_port_guide_teleport_push(
+	void)
+{
+	hud_port_guide_teleport_wanted = TRUE;
+}
+
+void hud_port_guide_teleport_update(
+	void)
+{
+	short local_player_index = local_player_get_next(NONE);
+	long player_index = local_player_index==NONE ? NONE : local_player_get_player_index(local_player_index);
+	long unit_index = player_index==NONE ? NONE : player_get(player_index)->unit_index;
+	real_point3d target;
+	long target_object_index;
+
+	if (hud_port_guide_teleport_watch>0 && unit_index!=NONE)
+	{
+		real_point3d origin;
+
+		hud_port_guide_teleport_watch--;
+		object_get_origin(unit_index, &origin);
+		if (!hud_port_guide_inside_level(&origin))
+		{
+			hud_port_guide_teleport_watch = 0;
+			player_teleport(player_index, NONE, &hud_port_guide_teleport_from);
+			terminal_printf(global_real_argb_orange, "Teletransporte: fuera del mapa, de vuelta");
+			error(_error_log, "port: teleport left the player outside the level: put back");
+		}
+	}
+	if (!hud_port_guide_teleport_wanted)
+		return;
+	hud_port_guide_teleport_wanted = FALSE;
+	if (unit_index==NONE || !hud_port_guide_teleport_allowed() ||
+		!hud_port_guide_target(unit_index, &target, &target_object_index))
+	{
+		return;
+	}
+	{
+		real_point3d start = target;
+		real_point3d floor_point;
+		long surface_index;
+		boolean done = FALSE;
+		short candidate_index;
+
+		if (hud_port_guide_target_is_volume)
+		{
+			start.x += (hud_port_guide_target_center.x-target.x)*GUIDE_TELEPORT_INSIDE;
+			start.y += (hud_port_guide_target_center.y-target.y)*GUIDE_TELEPORT_INSIDE;
+			start.z += (hud_port_guide_target_center.z-target.z)*GUIDE_TELEPORT_INSIDE;
+		}
+		else
+		{
+			real_point3d origin;
+			real_vector3d away;
+			real length;
+
+			/* (beside it, on the player's side) */
+			object_get_origin(unit_index, &origin);
+			away.i = origin.x-target.x;
+			away.j = origin.y-target.y;
+			away.k = 0.f;
+			length = square_root(away.i*away.i+away.j*away.j);
+			if (length>0.01f)
+			{
+				start.x += away.i/length*GUIDE_TELEPORT_BESIDE;
+				start.y += away.j/length*GUIDE_TELEPORT_BESIDE;
+			}
+		}
+		object_get_origin(unit_index, &hud_port_guide_teleport_from);
+		start.z += 1.f;
+		if (hud_port_guide_floor(&start, 8.f, &floor_point, &surface_index))
+		{
+			floor_point.z += 0.3f;
+			done = hud_port_guide_teleport_to(player_index, &floor_point);
+		}
+		/* (else the floors the arrow's route knows for it) */
+		for (candidate_index = 0; !done && candidate_index<3; candidate_index++)
+		{
+			if (hud_port_guide_goal_floor(&target, candidate_index, &floor_point, &surface_index))
+			{
+				floor_point.z += 0.3f;
+				done = hud_port_guide_teleport_to(player_index, &floor_point);
+			}
+		}
+		/* (else a free floor around it, in rings 2 to 10 meters out: the spot
+		itself can be too tight, or its floor deeper than the first look) */
+		{
+			short ring, step;
+
+			for (ring = 1; !done && ring<=GUIDE_TELEPORT_RINGS; ring++)
+			{
+				for (step = 0; !done && step<GUIDE_TELEPORT_RING_STEPS; step++)
+				{
+					real angle = step*(2*_pi/GUIDE_TELEPORT_RING_STEPS);
+					real_point3d around = start;
+
+					around.x += cosine(angle)*GUIDE_TELEPORT_RING_SPACING*ring;
+					around.y += sine(angle)*GUIDE_TELEPORT_RING_SPACING*ring;
+					around.z += 2.f;
+					if (hud_port_guide_floor(&around, 16.f, &floor_point, &surface_index))
+					{
+						floor_point.z += 0.3f;
+						done = hud_port_guide_teleport_to(player_index, &floor_point);
+					}
+				}
+			}
+		}
+		/* (never to the target itself, with no floor found under it: it can be
+		in a wall, or outside the level) */
+		if (done)
+			hud_port_guide_teleport_watch = GUIDE_TELEPORT_WATCH_TICKS;
+		else
+			terminal_printf(global_real_argb_orange, "Teletransporte: no hay donde pararse ahi");
+		error(_error_log, "port: teleport to the guide arrow's target (%.1f %.1f %.1f): %s",
+			target.x, target.y, target.z, done ? "done" : "no room");
+	}
+
+	return;
+}
